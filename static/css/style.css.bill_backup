*{box-sizing:border-box}html{font-size:14px;touch-action:pan-y}body{margin:0;background:#fff;color:#171717;font-family:Georgia,'Times New Roman',serif;font-size:14px;padding-bottom:76px}.topbar{height:52px;border-top:5px solid #079b8a;display:flex;align-items:center;justify-content:space-between;padding:0 16px;background:#fff}.brand{font-size:22px;font-weight:bold;color:#111;text-decoration:none}.message{color:#079b8a;text-decoration:none}.page{max-width:680px;margin:auto;padding:0 12px 14px}.hero{height:210px;position:relative;overflow:hidden;margin:0 -12px 16px;background:#063b39}.hero img{width:100%;height:100%;object-fit:cover;display:block;animation:buildReveal 4s ease-out both}.build-mask{position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.38),transparent 48%);pointer-events:none}.hero-caption{position:absolute;bottom:0;left:0;right:0;padding:10px;color:#a9fff0;font-size:18px;background:rgba(0,0,0,.3)}@keyframes buildReveal{0%{clip-path:inset(100% 0 0 0);transform:scale(1.08)}100%{clip-path:inset(0);transform:scale(1)}}.stats{display:grid;gap:10px;margin:12px 0}.stats.two{grid-template-columns:repeat(2,minmax(0,1fr))}.stats.three{grid-template-columns:repeat(3,minmax(0,1fr))}.stat{border:1.5px solid #0a9d8d;border-radius:14px;overflow:hidden;text-align:center;box-shadow:0 2px 7px #0a9d8d22}.stat strong{display:block;font-size:21px;padding:13px 4px}.stat span{display:block;background:#079b8a;color:#fff;padding:9px 3px;font-weight:bold;font-size:13px}.message-card,.salary,.wallet,.menu-grid,.refbox,.level{border:1.5px solid #169c8d;border-radius:17px;padding:14px;margin:14px 0;box-shadow:0 2px 8px #078f8120}.message-card{display:grid;gap:15px;font-size:17px}.message-card span{border-top:1px solid #ccc;padding-top:12px}.bottom{position:fixed;bottom:0;left:0;right:0;height:64px;background:#fff;border-top:1px solid #ddd;display:flex;justify-content:space-around;align-items:center;z-index:5}.bottom a{display:flex;flex-direction:column;align-items:center;text-decoration:none;color:#333;font-size:23px;line-height:24px}.bottom small{font-size:12px;font-weight:bold}.bottom .active{color:#079b8a}.profile-line{display:flex;align-items:center;gap:12px;padding:12px 4px;font-size:17px}.profile-line span{color:#888}.logo{margin-left:auto;border:3px solid #079b8a;border-radius:50%;width:64px;height:64px;display:flex;align-items:center;justify-content:center;flex-direction:column;color:#111;font-size:25px;box-shadow:0 2px 8px #079b8a33}.logo small{font-size:10px}.wallet{border-radius:35px;display:flex;justify-content:space-around;text-align:center;position:relative;padding:20px 8px 28px}.wallet span,.salary span{display:block;color:#777;font-size:16px}.wallet strong,.salary strong{display:block;font-size:26px;margin-top:6px}.chevron{position:absolute;bottom:5px;color:#079b8a;font-size:28px}.menu-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:17px 8px;padding:24px 10px}.menu-item{display:flex;align-items:center;flex-direction:column;gap:5px;text-align:center;font-size:14px}.menu-item i{font-style:normal;background:#079b8a;color:white;width:58px;height:58px;border-radius:18px;display:grid;place-items:center;font-size:25px}.salary{display:grid;grid-template-columns:1fr 1fr;gap:12px}.salary button{grid-column:1/-1;background:#079b8a;color:#fff;border:0;border-radius:14px;padding:14px;font-size:16px;font-weight:bold}.logout{display:block;text-align:center;color:#079b8a;padding:8px}.tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:8px 0}.tabs a{text-align:center;text-decoration:none;color:#777;padding:12px 3px;font-size:16px}.tabs a.selected{color:#079b8a;border-bottom:3px solid #079b8a;font-weight:bold}.series-note{border:1px solid #8bd8cd;border-radius:12px;padding:12px;margin:10px 0 14px;font-size:14px;line-height:1.4}.machine{display:grid;grid-template-columns:36% 64%;border:1.5px solid #079b8a;border-radius:14px;overflow:hidden;margin:12px 0;min-height:120px;box-shadow:0 2px 8px #079b8a22}.machine-img{background:linear-gradient(135deg,#081315,#35474b);color:#5ff5e4;display:grid;place-items:center;font:bold 16px Arial}.machine>div:last-child{padding:12px 10px}.machine b{font-size:19px;color:#079b8a}.machine p{margin:7px 0;font-size:14px}.refbox p{overflow-wrap:anywhere}.refbox b{color:#079b8a}.team-counts{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:28px 0}.team-counts>div{border:1px solid #80cfc4;border-radius:14px;padding:14px;font-size:20px}.team-counts small{font-size:14px}.level{padding:0;overflow:hidden}.level header{background:#e8f7f4;display:flex;justify-content:space-between;padding:10px}.level header b{background:#079b8a;color:#fff;padding:8px 14px;margin:-10px;border-radius:12px}.level>div{display:flex;justify-content:space-between;padding:14px}.auth-shell{background:#131b22;color:#f6f7f8;border-radius:18px;padding:20px 16px;margin:18px 0;min-height:75vh}.auth-tabs{display:grid;grid-template-columns:1fr 1fr;margin-bottom:18px}.auth-tabs a{text-align:center;text-decoration:none;color:#aab0b7;padding:13px 4px;font-size:17px}.auth-tabs .on{background:#0a0e12;color:white;border-radius:9px}.auth-shell label{display:block;margin:15px 0 7px;font:600 15px Arial}.auth-shell input{width:100%;border:1px solid #26313a;border-radius:14px;background:#111820;color:#fff;padding:15px 13px;font-size:15px;outline:none}.yellow{width:100%;border:0;border-radius:14px;background:#ffd64b;color:#111;font-size:17px;font-weight:bold;padding:16px;margin-top:24px}.forgot,.hint{display:block;text-align:center;color:#ffd64b;text-decoration:none;margin:20px 0;font-size:15px}.notice{background:#fff1c2;padding:10px;border-radius:8px;margin:10px 0}@media(max-width:380px){.page{padding-left:9px;padding-right:9px}.hero{margin-left:-9px;margin-right:-9px;height:185px}.menu-grid{gap:14px 4px}.menu-item i{width:52px;height:52px}.stat strong{font-size:19px}.machine{grid-template-columns:34% 66%}.machine p{font-size:13px}}
/* Functional bottom navigation with crisp scalable vector icons */
.bottom a{min-width:48px;gap:2px;font-size:inherit;line-height:normal}
.bottom a svg{width:25px;height:25px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round;display:block}
.bottom a[aria-label="Home"] svg,.bottom a[aria-label="Team"] svg,.bottom a[aria-label="My"] svg{fill:currentColor;stroke:currentColor}
.bottom a small{font-size:12px;line-height:15px}

/* Armazon compact visual refresh */
.topbar{height:58px;padding:0 16px;border-top:4px solid #079b8a;box-shadow:0 2px 8px #1231}
.brand{display:flex;align-items:center;gap:8px;text-decoration:none}
.brand-mark{width:31px;height:31px;display:grid;place-items:center;border-radius:10px 10px 10px 3px;background:linear-gradient(145deg,#12b8a3,#057d70);color:#fff;font:800 22px Arial;box-shadow:0 3px 8px #079b8a55}
.brand-word{font:800 23px Arial,sans-serif;letter-spacing:-1px;background:linear-gradient(90deg,#087f72,#13b39e);-webkit-background-clip:text;background-clip:text;color:transparent}
.notification{width:38px;height:38px;position:relative;display:grid;place-items:center;color:#078f81;border-radius:50%;background:#e8f8f5}
.notification svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.notification i{position:absolute;right:5px;top:4px;width:7px;height:7px;border-radius:50%;background:#f04d55;border:1px solid white}
.hero{height:174px;margin:0 -12px 12px;position:relative;overflow:hidden;background:#142c30}
.hero-slides,.hero-slide{position:absolute;inset:0;width:100%;height:100%}
.hero-slide{object-fit:cover;opacity:0;transition:opacity .9s ease}
.hero-slide.active{opacity:1}
.hero-shade{position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.58),transparent 65%)}
.hero-caption{font-size:16px;line-height:1.2;padding:9px 12px}
.slide-dots{position:absolute;right:12px;bottom:10px;display:flex;gap:5px}
.slide-dots span{width:5px;height:5px;border-radius:8px;background:#ffffff88}
.slide-dots span.current{width:15px;background:#fff}
.stats{gap:8px;margin:9px 0}
.stat{border-radius:12px;box-shadow:0 2px 5px #078f8118}
.stat strong{font-size:18px;padding:9px 3px}
.stat span{padding:7px 2px;font-size:11px}
.stats.three .stat strong{font-size:17px;padding:8px 2px}
.stats.three .stat span{font-size:10px}
.message-card{min-height:116px;padding:13px 14px;border-radius:15px;margin:12px 0 20px;gap:11px}
.message-heading{display:flex;align-items:center;gap:9px;font-size:17px;padding-bottom:9px;border-bottom:1px solid #d9e4e2}
.message-heading a{margin-left:auto;color:#079b8a;text-decoration:none;font-size:13px;font-weight:bold}
.message-icon{width:31px;height:31px;background:#079b8a;color:white;border-radius:10px;display:grid;place-items:center}
.message-icon svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.message-item{display:flex;align-items:center;gap:10px;font-size:15px;padding:5px 0}
.star-icon{width:27px;height:27px;border-radius:9px;background:#e6f7f3;color:#079b8a;display:grid;place-items:center;font-size:17px}
.bottom-nav{position:fixed;z-index:20;bottom:9px;left:12px;right:12px;height:62px;padding:5px 4px;display:flex;align-items:center;justify-content:space-around;background:rgba(255,255,255,.97);border:1px solid #d8e9e5;border-radius:20px;box-shadow:0 5px 22px #002c2530;backdrop-filter:blur(12px)}
.bottom-nav a{min-width:48px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;text-decoration:none;color:#606a68;font-size:inherit;line-height:normal}
.bottom-nav a svg{width:23px;height:23px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;display:block}
.bottom-nav a[aria-label="Home"] svg,.bottom-nav a[aria-label="Team"] svg,.bottom-nav a[aria-label="My"] svg{fill:currentColor;stroke:currentColor}
.bottom-nav a small{font:600 10px Arial,sans-serif;line-height:13px}
.bottom-nav a.active{color:#079b8a}
body{padding-bottom:88px}
@media(max-width:380px){.hero{height:158px}.stat strong{font-size:17px}.stat span{font-size:10px}.bottom-nav{left:8px;right:8px;height:58px}.bottom-nav a svg{width:21px;height:21px}}

/* Black and cyan phone registration / login form */
body:has(.nex-auth){background:#000;color:#f3f5f7}
body:has(.nex-auth) .page{max-width:650px;padding:0 20px 28px}
.nex-auth{min-height:calc(100vh - 115px);display:flex;flex-direction:column;justify-content:center;padding:30px 0 24px}
.nex-form{display:flex;flex-direction:column;gap:24px}
.field-row{height:78px;border:1.5px solid #07516a;border-radius:28px;display:flex;align-items:center;gap:15px;padding:0 20px;box-shadow:inset 0 0 0 1px #082b38}
.field-row>svg{width:26px;height:26px;flex:0 0 26px;fill:none;stroke:#d4d7db;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.field-row input{min-width:0;flex:1;background:transparent;border:0;outline:0;color:#f5f7f8;font:16px Georgia,serif}
.field-row input::placeholder{color:#777b80;opacity:1}
.eye-toggle{border:0;background:transparent;color:#d4d7db;font-size:24px;padding:4px}
.captcha-row{padding-right:12px}
.captcha-code{background:#fff;color:#178ac4;border-radius:7px;padding:10px 13px;font:bold 24px Georgia,serif;letter-spacing:5px;min-width:112px;text-align:center}
.nex-submit{height:66px;border:2px solid #00b9ee;border-radius:22px;background:transparent;color:#12b9eb;font:24px Georgia,serif;margin-top:0;box-shadow:0 0 5px #00a8d844}
.auth-switch{display:flex;justify-content:flex-start;margin-top:32px}
.auth-switch a{color:#eee;text-decoration:none;font:16px Georgia,serif}
body:has(.nex-auth) .notice{background:#12232b;color:#e9faff;border:1px solid #08708d}
@media(max-width:380px){.field-row{height:66px;border-radius:23px;padding:0 15px}.nex-form{gap:19px}.captcha-code{font-size:21px;min-width:95px}.nex-submit{height:59px}}

/* Clear Armazon identity and balanced form hierarchy */
.auth-brand{display:flex;align-items:center;justify-content:center;gap:10px;margin:0 auto 34px;color:#16b8e8;font:700 29px Georgia,serif;letter-spacing:.2px}
.auth-brand-mark{width:38px;height:38px;border:2px solid #12b8e8;border-radius:12px 12px 12px 4px;display:grid;place-items:center;font:800 25px Arial,sans-serif;color:#12b8e8;box-shadow:0 0 12px #00aee933}
.nex-auth{justify-content:flex-start;padding-top:36px}
.nex-form{gap:20px}
.field-row{min-height:76px;height:auto}
.nex-submit{margin-top:2px}
.auth-switch{margin-top:28px}
@media(max-height:760px){.nex-auth{padding-top:18px}.auth-brand{margin-bottom:22px}.nex-form{gap:15px}.field-row{min-height:65px}.auth-switch{margin-top:20px}}

/* Compact, responsive Armazon mobile layout */
html{font-size:13px}
body{font-size:13px}
.page{max-width:520px;padding:0 10px 12px}
.topbar{height:49px;padding:0 12px}
.brand-word{font-size:20px}
.brand-mark{width:27px;height:27px;font-size:19px}
.hero{height:165px;margin:0 -10px 10px}
.hero-caption{font-size:15px;padding:8px 10px}
.stats{gap:7px;margin:8px 0}
.stat{border-radius:11px}
.stat strong{font-size:18px;padding:9px 3px}
.stat span{font-size:11px;padding:6px 2px}
.message-card,.salary,.wallet,.menu-grid,.refbox,.level{padding:11px;margin:10px 0;border-radius:13px}
.message-card{font-size:15px;gap:10px}
.profile-line{font-size:15px;padding:9px 3px}
.logo{width:53px;height:53px;font-size:21px}
.wallet{padding:15px 7px 23px}
.wallet span,.salary span{font-size:14px}
.wallet strong,.salary strong{font-size:22px}
.menu-grid{gap:12px 6px;padding:17px 8px}
.menu-item{font-size:12px;gap:4px}
.menu-item i{width:48px;height:48px;border-radius:14px;font-size:21px}
.salary button{padding:11px;font-size:14px}
.tabs a{padding:9px 2px;font-size:14px}
.series-note{padding:9px;margin:8px 0 10px;font-size:12px}
.machine{margin:9px 0;min-height:100px;border-radius:11px}
.machine>div:last-child{padding:9px 8px}
.machine b{font-size:17px}
.machine p{font-size:12px;margin:5px 0}
.refbox p{font-size:13px;margin:6px 0}
.team-counts{gap:8px;margin:17px 0}
.team-counts>div{padding:10px;font-size:17px}
.level header{padding:8px;font-size:13px}
.level>div{padding:10px;font-size:12px}
.bottom-nav{left:10px;right:10px;bottom:7px;height:54px;border-radius:16px}
.bottom-nav a{min-width:42px}
.bottom-nav a svg{width:20px;height:20px}
.bottom-nav a small{font-size:9px;line-height:11px}
body{padding-bottom:72px}
/* Account forms styled to match the compact reference layout */
body:has(.compact-auth){background:#fff;color:#343a40;font-family:Arial,sans-serif}
body:has(.compact-auth) .page{max-width:500px;padding:10px 12px 24px}
.compact-auth{padding:0 2px 12px}
.compact-auth-card{background:#fff;border:1px solid #edf0f3;border-radius:16px;padding:16px 14px;box-shadow:0 2px 8px #17212b0a}
.compact-auth-card h1{text-align:center;font-size:21px;line-height:1.25;margin:0 0 5px;font-weight:750;color:#343a40}
.auth-subtitle{text-align:center;color:#9299a2;font-size:13px;margin:0 0 17px}
.compact-auth-card label{display:block;font-size:13px;font-weight:650;margin:12px 0 5px;color:#3f454c}
.compact-auth-card label em{color:#d56d75;font-style:normal}
.compact-auth-card label>input,.country-field,.password-field{width:100%;height:43px;margin-top:5px;background:#f3f5f7;border:1px solid #f0f2f4;border-radius:7px;display:flex;align-items:center}
.compact-auth-card label>input,.password-field input{padding:0 12px;color:#343a40;font:13px Arial,sans-serif;outline:0;min-width:0}
.compact-auth-card input::placeholder{color:#9aa1aa}
.country-field{gap:10px;padding:0 12px;background:#fff;border:1px solid #d7dce1}
.country-field span{font-size:20px}
.country-field select{flex:1;border:0;background:transparent;color:#555;font-size:13px;outline:0}
.password-field input{flex:1;height:100%;border:0;background:transparent}
.show-pass{height:100%;width:43px;border:1px solid #6c94a5;border-radius:0 6px 6px 0;background:#fff;color:#58839a;font-size:17px}
.compact-submit{width:100%;height:46px;border:0;border-radius:7px;background:#b98bd0;color:#fff;font-size:14px;font-weight:750;margin-top:14px}
.auth-divider{height:1px;background:#e5e7e9;margin:15px 0 12px}
.auth-switchline{text-align:center;color:#9aa1aa;font-size:13px;margin:0}
.auth-switchline a{color:#9670b0;font-weight:700;text-decoration:none;margin-left:4px}
.login-card{padding:20px 15px}
.auth-logo{width:48px;height:48px;border-radius:50%;margin:0 auto 8px;background:linear-gradient(135deg,#1ab5a2,#087d72);color:#fff;display:grid;place-items:center;font:bold 29px Georgia}
.login-card .compact-submit{margin-top:18px}
@media(max-width:380px){
 .page{padding-left:8px;padding-right:8px}
 .hero{height:145px}
 .stat strong{font-size:16px}
 .stat span{font-size:10px}
 .compact-auth-card{padding:13px 11px}
 .compact-auth-card h1{font-size:19px}
 .compact-auth-card label>input,.country-field,.password-field{height:40px}
}

/* Armazon unified emerald-teal premium palette; preserves all existing layout */
body:not(:has(.compact-auth)){
  background:#F7F8F5;
  color:#252D2B;
}
body:not(:has(.compact-auth)) .topbar,
body:not(:has(.compact-auth)) .bottom{background:#F7F8F5}
body:not(:has(.compact-auth)) .topbar{border-top-color:#087F70;box-shadow:0 2px 8px #252d2b12}
body:not(:has(.compact-auth)) .brand{color:#252D2B}
body:not(:has(.compact-auth)) .brand-mark{
  background:linear-gradient(145deg,#0C927F,#075F55);
  box-shadow:0 3px 8px #087f7040
}
body:not(:has(.compact-auth)) .brand-word{
  background:linear-gradient(90deg,#075F55,#0C927F);
  -webkit-background-clip:text;background-clip:text;color:transparent
}
body:not(:has(.compact-auth)) .message,
body:not(:has(.compact-auth)) .bottom .active,
body:not(:has(.compact-auth)) .chevron,
body:not(:has(.compact-auth)) .logout,
body:not(:has(.compact-auth)) .refbox b{color:#087F70}
body:not(:has(.compact-auth)) .stat,
body:not(:has(.compact-auth)) .message-card,
body:not(:has(.compact-auth)) .salary,
body:not(:has(.compact-auth)) .wallet,
body:not(:has(.compact-auth)) .menu-grid,
body:not(:has(.compact-auth)) .refbox,
body:not(:has(.compact-auth)) .level,
body:not(:has(.compact-auth)) .machine,
body:not(:has(.compact-auth)) .team-counts>div{
  border-color:#A9C9BE;
  box-shadow:0 2px 8px #252D2B10
}
body:not(:has(.compact-auth)) .stat span,
body:not(:has(.compact-auth)) .menu-item i,
body:not(:has(.compact-auth)) .salary button,
body:not(:has(.compact-auth)) .level header b{
  background:#087F70;color:#fff
}
body:not(:has(.compact-auth)) .stat strong,
body:not(:has(.compact-auth)) .profile-line,
body:not(:has(.compact-auth)) .wallet strong,
body:not(:has(.compact-auth)) .salary strong,
body:not(:has(.compact-auth)) .message-card,
body:not(:has(.compact-auth)) .machine p,
body:not(:has(.compact-auth)) .team-counts>div{color:#252D2B}
body:not(:has(.compact-auth)) .logo{
  border-color:#087F70;color:#252D2B;box-shadow:0 2px 8px #087f7028
}
body:not(:has(.compact-auth)) .tabs a.selected{
  color:#087F70;border-bottom-color:#087F70
}
body:not(:has(.compact-auth)) .series-note{
  border-color:#A9C9BE;background:#EEF3EF;color:#34413D
}
body:not(:has(.compact-auth)) .machine b{color:#087F70}
body:not(:has(.compact-auth)) .machine-img{
  background:linear-gradient(135deg,#183D37,#42645A);color:#F7F8F5
}
body:not(:has(.compact-auth)) .level header{background:#E8F0EB;color:#252D2B}
body:not(:has(.compact-auth)) .bottom{border-top-color:#DCE5DF}
body:not(:has(.compact-auth)) .notice{
  background:#EEF3EF;border:1px solid #A9C9BE;color:#34413D
}
body:not(:has(.compact-auth)) .hero{background:#183D37}
body:not(:has(.compact-auth)) .hero-caption{color:#F7F8F5}

/* ARMAZON: dark midnight and electric-blue visual system from supplied home reference */
body:not(:has(.compact-auth)){
  background:#03070D!important;color:#F2F7FC!important;
}
body:not(:has(.compact-auth)) .topbar{
  background:#03070D!important;border-top:4px solid #16B9F4!important;
  box-shadow:0 2px 12px #079fe733!important;
}
body:not(:has(.compact-auth)) .brand-word{
  background:linear-gradient(90deg,#EAF8FF,#48C8FF)!important;
  -webkit-background-clip:text!important;background-clip:text!important;color:transparent!important;
}
body:not(:has(.compact-auth)) .brand-mark{
  background:linear-gradient(145deg,#26C5FF,#0879C6)!important;
  box-shadow:0 3px 12px #11AFFF55!important;
}
body:not(:has(.compact-auth)) .message,
body:not(:has(.compact-auth)) .logout,
body:not(:has(.compact-auth)) .refbox b,
body:not(:has(.compact-auth)) .chevron{color:#38BFFF!important}
body:not(:has(.compact-auth)) .page{background:transparent!important}
body:not(:has(.compact-auth)) .hero{
  height:205px!important;background:#061B2D!important;
  border-bottom:2px solid #087FC1!important;
}
body:not(:has(.compact-auth)) .hero-shade{
  background:linear-gradient(0deg,rgba(0,0,0,.78),rgba(0,0,0,.02) 75%)!important;
}
body:not(:has(.compact-auth)) .hero-caption{
  color:#A9E6FF!important;background:rgba(0,8,18,.55)!important;
  font-size:16px!important;
}
body:not(:has(.compact-auth)) .slide-dots span{background:#9adfff88}
body:not(:has(.compact-auth)) .slide-dots span.current{background:#36C3FF}
body:not(:has(.compact-auth)) .stat{
  background:#F8FBFF!important;border:1px solid #B8E7FA!important;
  border-radius:9px!important;box-shadow:0 3px 10px #0B8AC533!important;
  color:#101820!important;
}
body:not(:has(.compact-auth)) .stat strong{
  background:#F8FBFF!important;color:#101820!important;
}
body:not(:has(.compact-auth)) .stat span{
  background:linear-gradient(90deg,#38BDF8,#168DCE)!important;
  color:#EAF8FF!important;font-weight:600!important;
}
body:not(:has(.compact-auth)) .message-card{
  background:linear-gradient(135deg,#062A48,#064D78)!important;
  border:1px solid #168BC5!important;border-top:3px solid #20B9F5!important;
  border-radius:7px!important;color:#F2FAFF!important;
  box-shadow:0 4px 16px #007fc433!important;min-height:140px!important;
}
body:not(:has(.compact-auth)) .message-heading{
  color:#F5FBFF!important;border-bottom-color:#2788B5!important;
  font-size:19px!important;letter-spacing:1px!important;
}
body:not(:has(.compact-auth)) .message-heading a{color:#6DD5FF!important}
body:not(:has(.compact-auth)) .message-icon{
  background:#087EB7!important;color:#fff!important;border-radius:50%!important;
}
body:not(:has(.compact-auth)) .message-item{color:#B9E8FF!important}
body:not(:has(.compact-auth)) .star-icon{
  background:#07395B!important;color:#6ED4FF!important;
}
body:not(:has(.compact-auth)) .salary,
body:not(:has(.compact-auth)) .wallet,
body:not(:has(.compact-auth)) .menu-grid,
body:not(:has(.compact-auth)) .refbox,
body:not(:has(.compact-auth)) .level,
body:not(:has(.compact-auth)) .team-counts>div,
body:not(:has(.compact-auth)) .machine{
  background:#071522!important;border:1px solid #126A99!important;
  color:#EAF6FF!important;box-shadow:0 3px 12px #008bd022!important;
}
body:not(:has(.compact-auth)) .wallet span,
body:not(:has(.compact-auth)) .salary span,
body:not(:has(.compact-auth)) .profile-line span{color:#9DB7C8!important}
body:not(:has(.compact-auth)) .wallet strong,
body:not(:has(.compact-auth)) .salary strong,
body:not(:has(.compact-auth)) .profile-line b{color:#F3FAFF!important}
body:not(:has(.compact-auth)) .logo{
  border-color:#20B9F5!important;color:#EAF8FF!important;
  background:#061B2D!important;box-shadow:0 2px 12px #079fe733!important;
}
body:not(:has(.compact-auth)) .menu-item{color:#EAF6FF!important}
body:not(:has(.compact-auth)) .menu-item i{
  background:linear-gradient(145deg,#20B9F5,#0879C6)!important;color:#fff!important;
}
body:not(:has(.compact-auth)) .salary button{
  background:linear-gradient(90deg,#38BDF8,#168DCE)!important;color:#fff!important;
}
body:not(:has(.compact-auth)) .tabs a{color:#9DB7C8!important}
body:not(:has(.compact-auth)) .tabs a.selected{
  color:#54CCFF!important;border-bottom-color:#20B9F5!important;
}
body:not(:has(.compact-auth)) .series-note{
  background:#071D30!important;border:1px solid #1476A8!important;color:#C7E9FA!important;
}
body:not(:has(.compact-auth)) .machine b{color:#55CFFF!important}
body:not(:has(.compact-auth)) .machine p{color:#EAF6FF!important}
body:not(:has(.compact-auth)) .machine-img{
  background:linear-gradient(145deg,#06111D,#0B3C5B)!important;color:#74D8FF!important;
}
body:not(:has(.compact-auth)) .level header{
  background:#0A2A40!important;color:#EAF6FF!important;
}
body:not(:has(.compact-auth)) .level header b{
  background:#168DCE!important;color:#fff!important;
}
body:not(:has(.compact-auth)) .level>div{color:#D7ECF8!important}
body:not(:has(.compact-auth)) .bottom-nav{
  background:#050C14!important;border:1px solid #125B82!important;
  box-shadow:0 4px 20px #0009!important;
}
body:not(:has(.compact-auth)) .bottom-nav a{color:#B6C6D2!important}
body:not(:has(.compact-auth)) .bottom-nav a.active{color:#38BDF8!important}
body:not(:has(.compact-auth)) .notice{
  background:#082B45!important;border:1px solid #168DCE!important;color:#EAF8FF!important;
}
body:not(:has(.compact-auth)) .profile-line{color:#F1F8FC!important}

/* ARMAZON WHITE THEME — clean, compact, no animation */
html{background:#fff!important}
body{background:#fff!important;color:#20252b!important}
.topbar{background:#fff!important;border-top:4px solid #159b8c!important;box-shadow:0 2px 9px rgba(20,70,65,.08)!important}
.brand-word{color:#173b37!important;background:none!important;-webkit-text-fill-color:#173b37!important}
.brand-mark{background:#159b8c!important;color:#fff!important;box-shadow:none!important}
.notification{color:#159b8c!important}
.page{background:#fff!important}
.hero{height:178px!important;background:#edf7f5!important;border-radius:10px!important;overflow:hidden!important}
.hero img{animation:none!important;transform:none!important;clip-path:none!important;object-fit:cover!important}
.build-mask{background:linear-gradient(0deg,rgba(0,0,0,.48),transparent 70%)!important}
.hero-caption{color:#fff!important;background:rgba(0,0,0,.18)!important;font-size:15px!important}
.stat{background:#fff!important;border:1px solid #d6e7e3!important;border-radius:10px!important;box-shadow:0 2px 7px rgba(20,70,65,.07)!important;color:#20252b!important}
.stat strong{background:#fff!important;color:#20252b!important}
.stat span{background:#159b8c!important;color:#fff!important}
.message-card{background:#fff!important;color:#20252b!important;border:1px solid #d2e5e1!important;border-radius:12px!important;box-shadow:0 2px 8px rgba(20,70,65,.07)!important}
.message-heading{color:#20252b!important;border-bottom-color:#e2e9e7!important}
.message-heading a{color:#159b8c!important}
.message-icon{background:#159b8c!important;color:#fff!important}
.message-item{color:#343b40!important}
.star-icon{background:#e8f5f2!important;color:#159b8c!important}
.salary,.wallet,.menu-grid,.refbox,.level,.team-counts>div,.machine{
 background:#fff!important;color:#20252b!important;border:1px solid #d6e7e3!important;
 box-shadow:0 2px 8px rgba(20,70,65,.06)!important;border-radius:12px!important
}
.wallet span,.salary span,.profile-line span{color:#68747a!important}
.wallet strong,.salary strong,.profile-line b{color:#20252b!important}
.logo{background:#fff!important;color:#159b8c!important;border-color:#159b8c!important;box-shadow:none!important}
.menu-item{color:#273238!important}
.menu-item i{background:#159b8c!important;color:#fff!important}
.salary button{background:#159b8c!important;color:#fff!important}
.tabs a{color:#66747a!important}
.tabs a.selected{color:#159b8c!important;border-bottom-color:#159b8c!important}
.series-note{background:#f7fbfa!important;border:1px solid #d6e7e3!important;color:#35434a!important}
.machine b{color:#159b8c!important}
.machine p{color:#303b40!important}
.machine-img{background:#eef6f4!important;color:#159b8c!important}
.level header{background:#eff8f6!important;color:#273238!important}
.level header b{background:#159b8c!important;color:#fff!important}
.level>div{color:#39464b!important}
.bottom-nav{background:rgba(255,255,255,.98)!important;border:1px solid #e0e9e6!important;box-shadow:0 2px 12px rgba(0,0,0,.09)!important}
.bottom-nav a{color:#59666b!important}
.bottom-nav a.active{color:#159b8c!important}
.notice{background:#f1f9f7!important;border:1px solid #b9ddd5!important;color:#23433d!important}
.logout{color:#159b8c!important}

/* Armazon home dashboard — visual direction from the supplied dark/gold reference */
body.home-page{background:#0b1015!important;color:#f5f6f7!important;font-family:Arial,Helvetica,sans-serif!important;padding-bottom:100px!important}
body.home-page .topbar{height:78px!important;padding:0 22px!important;background:#0b1015!important;border:0!important;box-shadow:none!important}
body.home-page .brand{gap:9px!important}
body.home-page .brand-mark{width:42px!important;height:42px!important;border-radius:0!important;background:transparent!important;color:#ffd21c!important;box-shadow:none!important;font-size:35px!important}
body.home-page .brand-word{font:800 30px Arial,sans-serif!important;letter-spacing:-1px!important;color:#f6f7f8!important;background:none!important;-webkit-text-fill-color:#f6f7f8!important}
body.home-page .notification{width:auto!important;height:auto!important;background:transparent!important;color:#fff!important;border-radius:0!important;display:flex!important;flex-direction:column!important;gap:2px!important;text-decoration:none!important}
body.home-page .notification svg{width:28px!important;height:28px!important;fill:#fff!important;stroke:#fff!important}
body.home-page .notification:after{content:"Message";font-size:12px;color:#f2f2f2}
body.home-page .notification i{width:17px!important;height:17px!important;right:-4px!important;top:-4px!important;background:#f04444!important}
body.home-page .page{max-width:900px!important;padding:0 16px 20px!important;background:transparent!important}
.home-dashboard{width:100%;color:#f5f6f7}
.home-hero{height:185px;position:relative;overflow:hidden;border:1px solid #303b45;border-radius:22px;margin:5px 0 0;background:#111820}
.home-hero img{width:100%;height:100%;display:block;object-fit:cover;animation:none!important;transform:none!important}
.home-hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(7,12,17,.94) 0%,rgba(7,12,17,.78) 36%,rgba(7,12,17,.08) 78%)}
.home-hero-copy{position:absolute;inset:0;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:18px 24px}
.home-hero-copy h1{margin:0;color:#fff;font-size:clamp(21px,5vw,29px);line-height:1.2;font-weight:800;letter-spacing:-.5px}
.home-hero-copy em{font-style:normal;color:#ffd21c}
.growth-mark{color:#ffd21c;font-size:48px;line-height:.9;font-weight:900;margin-left:120px;text-shadow:0 0 16px #ffd21c66}
.home-dots{height:28px;display:flex;justify-content:center;align-items:center;gap:9px}
.home-dots i{width:10px;height:10px;border-radius:50%;background:#626a70}
.home-dots i.on{background:#ffd21c}
.home-stat-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:10px 0 14px}
.home-stat{min-width:0;min-height:92px;display:flex;align-items:center;gap:12px;padding:13px 12px;text-decoration:none;color:#fff;background:linear-gradient(145deg,#171f27,#11171d);border:1px solid #303943;border-radius:19px;box-shadow:0 2px 7px #0005}
.home-stat-icon{flex:0 0 42px;color:#ffd21c;display:grid;place-items:center}
.home-stat-icon svg{width:39px;height:39px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.home-stat-data{display:flex;flex-direction:column;min-width:0;gap:4px}
.home-stat-data b{font-size:clamp(20px,5vw,27px);line-height:1.05;color:#f8f9fa}
.home-stat-data small{font-size:clamp(11px,3vw,14px);color:#f0f2f4;white-space:nowrap}
.home-arrow{margin-left:auto;color:#f1f3f4;font-size:28px;line-height:1}
.home-count-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:14px 0 16px}
.home-count-grid a{min-width:0;min-height:112px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;padding:9px 4px;text-decoration:none;color:#fff;background:linear-gradient(145deg,#171f27,#11171d);border:1px solid #303943;border-radius:19px}
.count-icon{font-size:27px;color:#ffd21c;line-height:1.1;font-weight:bold}
.home-count-grid b{font-size:23px;color:#fff}
.home-count-grid small{font-size:clamp(10px,2.8vw,13px);color:#f1f2f3;text-align:center;white-space:nowrap}
.home-message{margin:16px 0 18px;padding:17px 18px;background:linear-gradient(145deg,#171f27,#11171d);border:1px solid #303943;border-radius:20px;box-shadow:0 2px 7px #0005}
.home-message-head{display:flex;align-items:center;gap:12px;padding-bottom:13px;border-bottom:1px solid #3a4249;color:#f7f8f9;font-size:19px}
.bubble-icon{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#ffd21c;color:#15191d;font-size:13px;font-weight:900;letter-spacing:1px}
.home-message-head a{margin-left:auto;text-decoration:none;color:#ffd21c;font-size:17px}
.home-message-row{display:flex;align-items:center;gap:12px;padding-top:13px;text-decoration:none;color:#f5f6f7;font-size:16px}
.home-message-row .star-icon{width:32px;height:32px;display:grid;place-items:center;background:transparent;color:#ffd21c;font-size:28px}
.home-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:18px 2px 20px}
.home-actions a{min-height:65px;display:flex;align-items:center;justify-content:center;gap:10px;text-decoration:none;background:linear-gradient(180deg,#ffdf38,#ffc900);color:#111820;border-radius:17px;font-size:19px;font-weight:800;box-shadow:0 3px 8px #0005}
.home-actions a span{font-size:32px;line-height:1}
body.home-page .bottom-nav{left:10px!important;right:10px!important;bottom:8px!important;height:72px!important;padding:6px 5px!important;background:linear-gradient(145deg,#171f27,#11171d)!important;border:1px solid #303943!important;border-radius:25px!important;box-shadow:0 5px 20px #0009!important}
body.home-page .bottom-nav a{color:#f1f3f5!important;font-family:Arial,sans-serif!important;font-size:13px!important}
body.home-page .bottom-nav a svg{width:27px!important;height:27px!important}
body.home-page .bottom-nav a.active{color:#ffd21c!important}
@media(max-width:380px){
 body.home-page .page{padding-left:11px!important;padding-right:11px!important}
 .home-stat{gap:7px;padding:10px 8px;min-height:84px}
 .home-stat-icon{flex-basis:34px}
 .home-stat-icon svg{width:32px;height:32px}
 .home-message{padding:13px}
 .home-actions a{font-size:17px}
}

/* Compact dashboard and layered animated emerald waves */
body.home-page{padding-bottom:77px!important;position:relative;isolation:isolate}
body.home-page::before,body.home-page::after{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;background-repeat:repeat;opacity:.48}
body.home-page::before{background-image:repeating-radial-gradient(ellipse 210px 65px at 10% 70%,transparent 0 22px,rgba(0,224,139,.27) 23px 24px,transparent 25px 37px),repeating-radial-gradient(ellipse 230px 75px at 90% 20%,transparent 0 23px,rgba(29,235,143,.2) 24px 25px,transparent 26px 39px);background-size:380px 180px,430px 210px;animation:armazonWaveDrift 11.5s linear infinite}
body.home-page::after{background-image:repeating-radial-gradient(ellipse 175px 45px at 50% 50%,transparent 0 17px,rgba(20,255,154,.23) 18px 19px,transparent 20px 29px);background-size:300px 130px;opacity:.35;animation:armazonWaveDriftReverse 17s linear infinite}
@keyframes armazonWaveDrift{to{background-position:380px 180px,-430px 210px}}
@keyframes armazonWaveDriftReverse{to{background-position:-300px 130px}}
body.home-page .topbar{height:58px!important;padding:0 14px!important}
body.home-page .brand-mark{width:30px!important;height:30px!important;font-size:27px!important}
body.home-page .brand-word{font-size:24px!important}
body.home-page .notification svg{width:23px!important;height:23px!important}
body.home-page .notification:after{font-size:10px}
body.home-page .page{max-width:580px!important;padding:0 10px 8px!important}
.home-hero{height:135px;border-radius:15px;margin-top:2px}
.home-hero-copy{padding:12px 17px}
.home-hero-copy h1{font-size:clamp(17px,4.5vw,23px);line-height:1.15}
.growth-mark{font-size:32px;margin-left:90px}
.home-dots{height:20px;gap:6px}
.home-dots i{width:7px;height:7px}
.home-stat-grid{gap:8px;margin:6px 0 9px}
.home-stat{min-height:68px;gap:6px;padding:8px;border-radius:12px}
.home-stat-icon{flex-basis:28px}
.home-stat-icon svg{width:27px;height:27px}
.home-stat-data{gap:3px}
.home-stat-data b{font-size:clamp(17px,4.4vw,21px)}
.home-stat-data small{font-size:clamp(9px,2.5vw,11px)}
.home-arrow{font-size:20px}
.home-count-grid{gap:7px;margin:9px 0 10px}
.home-count-grid a{min-height:77px;gap:3px;padding:6px 2px;border-radius:12px}
.count-icon{font-size:20px}
.home-count-grid b{font-size:19px}
.home-count-grid small{font-size:clamp(9px,2.5vw,11px)}
.home-message{margin:10px 0 12px;padding:10px 12px;border-radius:13px}
.home-message-head{font-size:16px;padding-bottom:8px;gap:8px}
.home-message-head a{font-size:13px}
.bubble-icon{width:27px;height:27px;font-size:10px}
.home-message-row{font-size:13px;gap:8px;padding-top:7px}
.home-message-row .star-icon{width:25px;height:25px;font-size:23px}
.home-actions{gap:8px;margin:10px 1px 12px}
.home-actions a{min-height:47px;border-radius:12px;font-size:15px;gap:7px}
.home-actions a span{font-size:23px}
body.home-page .bottom-nav{left:7px!important;right:7px!important;bottom:5px!important;height:58px!important;border-radius:18px!important;padding:4px!important}
body.home-page .bottom-nav a{font-size:11px!important}
body.home-page .bottom-nav a svg{width:22px!important;height:22px!important}
@media(prefers-reduced-motion:reduce){body.home-page::before,body.home-page::after{animation:none}}

/* Final home cleanup: no top brand strip or text over the hero */
body.home-page .topbar{display:none!important}
body.home-page .page{padding-top:10px!important}
.home-hero{height:255px!important;display:grid!important;grid-template-columns:34% 66%!important;align-items:stretch!important;background:#0b1015!important;border:1px solid #27343a!important;border-radius:18px!important;overflow:hidden!important;margin:0 0 14px!important}
.home-hero-empty{display:block!important;background:linear-gradient(145deg,#0b1015,#111b20 75%,#0b1015)!important;position:relative!important}
.home-hero-empty:after{content:"";position:absolute;right:0;top:12%;bottom:12%;width:2px;background:linear-gradient(transparent,#23a879,transparent);opacity:.55}
.home-hero img{width:100%!important;height:100%!important;object-fit:cover!important;object-position:54% center!important;display:block!important;animation:none!important;transform:none!important}
.home-hero-shade,.home-hero-copy,.home-dots{display:none!important}
.count-icon{width:35px!important;height:35px!important;display:grid!important;place-items:center!important;color:#ffd21c!important;font-size:0!important}
.count-icon svg{width:31px!important;height:31px!important;fill:none!important;stroke:currentColor!important;stroke-width:1.9!important;stroke-linecap:round!important;stroke-linejoin:round!important}
.bubble-icon{flex:0 0 34px!important}
.bubble-icon svg{width:23px!important;height:23px!important;fill:none!important;stroke:currentColor!important;stroke-width:1.8!important;stroke-linecap:round!important;stroke-linejoin:round!important}
.home-message-row .star-icon{background:transparent!important}
.home-message-row .star-icon svg{width:27px!important;height:27px!important;fill:#ffd21c!important;stroke:#ffd21c!important;stroke-width:1.2!important}
.home-actions a span{display:grid!important;place-items:center!important}
.home-actions a span svg{width:27px!important;height:27px!important;fill:none!important;stroke:currentColor!important;stroke-width:2.2!important;stroke-linecap:round!important;stroke-linejoin:round!important}
.home-stat-icon svg{fill:none!important}
@media(max-width:390px){
 .home-hero{height:225px!important;grid-template-columns:32% 68%!important}
}

/* Full-width horizontal hero carousel */
.home-hero{
  position:relative!important;
  display:block!important;
  width:100%!important;
  height:clamp(190px, 56vw, 265px)!important;
  margin:0 0 16px!important;
  padding:0!important;
  overflow:hidden!important;
  border:1px solid #2a3940!important;
  border-radius:17px!important;
  background:#10191e!important;
}
.home-carousel-track{
  display:flex!important;
  width:100%!important;
  height:100%!important;
  transition:transform .75s cubic-bezier(.22,.7,.25,1)!important;
  will-change:transform;
}
.home-slide{
  position:relative!important;
  flex:0 0 100%!important;
  width:100%!important;
  height:100%!important;
  overflow:hidden!important;
}
.home-slide img{
  position:absolute!important;
  inset:0!important;
  display:block!important;
  width:100%!important;
  height:100%!important;
  object-fit:cover!important;
  object-position:center!important;
  animation:none!important;
  transform:none!important;
}
.home-slide:after{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(90deg,rgba(4,10,14,.88) 0%,rgba(4,10,14,.56) 48%,rgba(4,10,14,.04) 100%);
  pointer-events:none;
}
.home-slide-copy{
  position:absolute!important;
  z-index:2!important;
  left:17px!important;
  right:20px!important;
  bottom:32px!important;
  display:flex!important;
  flex-direction:column!important;
  gap:6px!important;
  max-width:78%!important;
  color:#fff!important;
  text-align:left!important;
  text-shadow:0 2px 8px rgba(0,0,0,.65)!important;
}
.home-slide-copy strong{
  font-size:clamp(17px,4.5vw,23px)!important;
  line-height:1.2!important;
  font-weight:800!important;
  letter-spacing:.1px!important;
}
.home-slide-copy small{
  font-size:clamp(10px,2.8vw,12px)!important;
  line-height:1.3!important;
  color:#f3d96a!important;
  font-weight:600!important;
}
.home-carousel-dots{
  position:absolute!important;
  z-index:4!important;
  left:0!important;
  right:0!important;
  bottom:9px!important;
  display:flex!important;
  justify-content:center!important;
  align-items:center!important;
  gap:7px!important;
}
.home-carousel-dots span{
  display:block!important;
  width:7px!important;
  height:7px!important;
  border-radius:50%!important;
  background:rgba(255,255,255,.55)!important;
  transition:all .25s ease!important;
}
.home-carousel-dots span.active{
  width:19px!important;
  border-radius:10px!important;
  background:#ffd21c!important;
}

/* Floating customer-support shortcut */
.floating-support{
  position:fixed!important;
  z-index:80!important;
  right:18px!important;
  bottom:calc(88px + env(safe-area-inset-bottom, 0px))!important;
  width:58px!important;
  height:58px!important;
  border-radius:50%!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  background:linear-gradient(145deg,#22b8e6,#0876c9)!important;
  border:3px solid rgba(255,255,255,.95)!important;
  box-shadow:0 5px 18px rgba(0,120,210,.38)!important;
  text-decoration:none!important;
}
.floating-support svg{
  width:30px!important;
  height:30px!important;
  fill:none!important;
  stroke:#fff!important;
  stroke-width:1.9!important;
  stroke-linecap:round!important;
  stroke-linejoin:round!important;
}
.floating-support .support-online{
  position:absolute!important;
  top:2px!important;
  right:2px!important;
  width:11px!important;
  height:11px!important;
  border-radius:50%!important;
  background:#22c887!important;
  border:2px solid #fff!important;
}
@media(min-width:700px){
  .floating-support{right:calc((100vw - min(100vw, 520px))/2 + 18px)!important;}
}

/* Repeating machine-typed welcome line */
.welcome-typewriter{
  min-height:34px;
  margin:0 2px 12px;
  padding:5px 2px 8px;
  color:#f4c928;
  font-size:clamp(15px,4.1vw,20px);
  line-height:1.35;
  font-weight:700;
  letter-spacing:.15px;
  text-align:left;
  overflow:hidden;
  white-space:nowrap;
}
.typing-cursor{
  display:inline-block;
  width:2px;
  height:1.05em;
  margin-left:3px;
  vertical-align:-.15em;
  background:#f4c928;
  animation:amazon-caret .75s steps(1,end) infinite;
}
@keyframes amazon-caret{50%{opacity:0}}


/* Refined Amazon welcome notice */
.amazon-welcome-overlay{position:fixed;inset:0;z-index:10000;background:rgba(5,12,17,.72);display:flex;align-items:center;justify-content:center;padding:16px;backdrop-filter:blur(7px);-webkit-backdrop-filter:blur(7px)}
.amazon-welcome-popup{position:relative;width:min(100%,390px);max-height:88vh;overflow:auto;background:linear-gradient(155deg,#17232b 0%,#101820 58%,#0c141b 100%);border:1px solid rgba(245,198,35,.36);border-radius:22px;padding:19px 18px 17px;box-shadow:0 24px 70px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.07);color:#f5f7f8}
.amazon-popup-topline{display:flex;align-items:center;gap:9px;padding:0 34px 15px 0;border-bottom:1px solid rgba(255,255,255,.09)}
.amazon-popup-brand-mark,.amazon-popup-footer-mark{display:grid;place-items:center;width:29px;height:29px;border-radius:9px;background:linear-gradient(145deg,#ffe36a,#e7a900);color:#15202a;font-weight:900;font-size:18px;font-family:Arial,sans-serif}
.amazon-popup-brand{font-size:13px;font-weight:850;letter-spacing:1.8px;color:#fff}
.amazon-popup-live{margin-left:auto;display:flex;align-items:center;gap:6px;font-size:9px;font-weight:800;letter-spacing:1.1px;color:#aebbc3}
.amazon-popup-live i{width:7px;height:7px;border-radius:50%;background:#37c995;box-shadow:0 0 9px rgba(55,201,149,.8)}
.amazon-popup-close{position:absolute;right:13px;top:13px;width:30px;height:30px;border:1px solid rgba(255,255,255,.12);border-radius:50%;background:rgba(255,255,255,.06);color:#eaf0f2;font-size:21px;line-height:1;cursor:pointer}
.amazon-popup-heading{display:flex;align-items:center;gap:13px;padding:19px 0 13px}
.amazon-popup-bell{flex:0 0 48px;width:48px;height:48px;border-radius:15px;display:grid;place-items:center;background:linear-gradient(145deg,#ffe15a,#e9ad00);color:#15202a;box-shadow:0 7px 18px rgba(235,178,0,.18)}
.amazon-popup-bell svg{width:25px;height:25px}
.amazon-popup-eyebrow{margin:0 0 4px;color:#e8bf37;font-size:9px;font-weight:850;letter-spacing:1.35px}
.amazon-welcome-popup h2{font-size:21px;line-height:1.15;margin:0;color:#fff;font-weight:800;letter-spacing:-.35px}
.amazon-popup-subtitle{margin:4px 0 0;color:#aebbc3;font-size:12px}
.amazon-popup-question{margin:4px 0 13px;color:#f0f3f4;font-size:13px;line-height:1.5;font-weight:650;min-height:20px}
.amazon-popup-info-list{display:grid;gap:8px}
.amazon-popup-info-row{display:flex;align-items:flex-start;gap:11px;padding:11px 12px;border:1px solid rgba(255,255,255,.075);border-radius:13px;background:rgba(255,255,255,.045);min-height:58px}
.amazon-popup-info-icon{flex:0 0 32px;width:32px;height:32px;display:grid;place-items:center;border-radius:10px;background:rgba(245,198,35,.12);color:#f5c623}
.amazon-popup-info-icon svg{width:19px;height:19px}
.amazon-popup-info-row strong{display:block;margin:0 0 3px;color:#f4cf55;font-size:11px;font-weight:800;letter-spacing:.15px}
.amazon-popup-info-row p{margin:0;color:#e5ebee;font-size:12px;line-height:1.45;overflow-wrap:anywhere;min-height:17px}
.amazon-popup-footer{display:flex;align-items:center;gap:9px;margin-top:13px;padding:11px 12px;border-radius:12px;background:rgba(255,255,255,.035);color:#f6d65f;font-size:12px;font-weight:750;min-height:42px}
.amazon-popup-footer-mark{width:23px;height:23px;border-radius:7px;font-size:14px;flex:0 0 23px}
.amazon-popup-done{display:flex;align-items:center;justify-content:center;gap:9px;width:100%;margin-top:14px;border:0;border-radius:12px;padding:12px 16px;background:linear-gradient(100deg,#ffdf45,#f3b900);color:#15202a;font-size:14px;font-weight:850;cursor:pointer;box-shadow:0 7px 18px rgba(235,178,0,.16)}
.amazon-popup-done[hidden]{display:none}
.amazon-welcome-overlay.is-closing{opacity:0;transition:opacity .2s ease}
@media(max-width:380px){.amazon-welcome-popup{padding:16px 14px 14px;border-radius:19px}.amazon-popup-heading{padding-top:15px}.amazon-welcome-popup h2{font-size:19px}.amazon-popup-info-row{padding:9px 10px}.amazon-popup-info-row p{font-size:11.5px}}


/* Compact My account page — matching the Amazon charcoal and gold home palette */
body.my-page{background:#0b1015!important;color:#f5f6f7!important;font-family:Arial,Helvetica,sans-serif!important;padding-bottom:82px!important}
body.my-page .topbar{background:#0b1015!important;border:0!important;box-shadow:none!important}
body.my-page .brand-word{color:#f6f7f8!important;-webkit-text-fill-color:#f6f7f8!important}
body.my-page .brand-mark{color:#ffd21c!important;background:transparent!important}
body.my-page .notification{color:#fff!important}
body.my-page .page{max-width:520px!important;padding:0 12px 16px!important;background:transparent!important}
.my-dashboard{width:100%;color:#f5f6f7}
.my-profile-line{display:flex;align-items:center;gap:10px;padding:7px 2px 12px;min-height:54px}
.my-user-details{display:flex;align-items:baseline;gap:12px;min-width:0;flex-wrap:wrap}
.my-user-details strong{font-size:clamp(17px,4.6vw,22px);letter-spacing:.1px;color:#fff;overflow-wrap:anywhere}
.my-user-details span{font-size:14px;color:#aeb8c0}
.my-brand-mark{margin-left:auto;flex:0 0 48px;width:48px;height:48px;border:2px solid #ffd21c;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#ffd21c;font-size:23px;font-weight:900;box-shadow:0 0 13px #ffd21c20}
.my-brand-mark span{font-size:7px;letter-spacing:.4px;color:#f6f7f8}
.my-wallet-card,.my-menu-card,.my-salary-card{background:linear-gradient(145deg,#171f27,#11171d);border:1px solid #303943;border-radius:17px;box-shadow:0 3px 12px #0005;margin:11px 0 13px}
.my-wallet-card{padding:15px 12px 9px}
.my-wallet-values,.my-salary-values{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.my-wallet-values>div,.my-salary-values>div{min-width:0;display:flex;flex-direction:column;gap:5px}
.my-wallet-values>div{text-align:center}
.my-wallet-values span,.my-salary-values span{font-size:13px;color:#aeb8c0;line-height:1.25}
.my-wallet-values strong,.my-salary-values strong{font-size:23px;line-height:1.1;color:#fff;font-weight:800}
.my-wallet-chevron{display:flex;justify-content:center;margin-top:9px;color:#ffd21c}
.my-wallet-chevron svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2.8;stroke-linecap:round;stroke-linejoin:round}
.my-menu-card{padding:13px 8px}
.my-menu-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px 5px}
.my-menu-item{min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:6px;text-align:center;text-decoration:none;color:#f4f6f7;font-size:12px;line-height:1.2;font-weight:600}
.my-menu-icon{width:49px;height:49px;border-radius:14px;display:grid;place-items:center;background:linear-gradient(145deg,#252f39,#171f27);border:1px solid #39434c;color:#ffd21c;box-shadow:0 3px 9px #0004}
.my-menu-icon svg{width:25px;height:25px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
.my-menu-item:active .my-menu-icon{transform:scale(.96)}
.my-salary-card{padding:14px 12px 12px}
.my-salary-values{margin-bottom:12px}
.my-salary-values strong{font-size:22px}
.my-salary-card button{width:100%;border:0;border-radius:12px;padding:11px 8px;background:linear-gradient(180deg,#ffdf38,#ffc900);color:#15191d;font-size:13px;font-weight:800;opacity:.72}
.my-logout{display:block;text-align:center;padding:7px;color:#c7d0d7;font-size:12px;text-decoration:none}
body.my-page .bottom-nav{left:10px!important;right:10px!important;bottom:7px!important;height:58px!important;padding:4px!important;background:linear-gradient(145deg,#171f27,#11171d)!important;border:1px solid #303943!important;border-radius:18px!important;box-shadow:0 5px 20px #0009!important}
body.my-page .bottom-nav a{color:#f1f3f5!important;font-family:Arial,sans-serif!important;font-size:11px!important}
body.my-page .bottom-nav a svg{width:22px!important;height:22px!important}
body.my-page .bottom-nav a.active{color:#ffd21c!important}
@media(max-width:380px){body.my-page .page{padding-left:9px!important;padding-right:9px!important}.my-menu-grid{gap:13px 3px}.my-menu-icon{width:45px;height:45px;border-radius:13px}.my-menu-icon svg{width:23px;height:23px}.my-menu-item{font-size:11px}.my-wallet-values strong,.my-salary-values strong{font-size:20px}}

/* My page: remove the extra top brand header and reuse the home page's emerald wave backdrop */
body.my-page{position:relative;isolation:isolate;background:#0b1015!important}
body.my-page .topbar{display:none!important}
body.my-page::before,body.my-page::after{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;background-repeat:repeat;opacity:.48}
body.my-page::before{background-image:repeating-radial-gradient(ellipse 210px 65px at 10% 70%,transparent 0 22px,rgba(0,224,139,.27) 23px 24px,transparent 25px 37px),repeating-radial-gradient(ellipse 230px 75px at 90% 20%,transparent 0 23px,rgba(29,235,143,.2) 24px 25px,transparent 26px 39px);background-size:380px 180px,430px 210px;animation:armazonWaveDrift 11.5s linear infinite}
body.my-page::after{background-image:repeating-radial-gradient(ellipse 175px 45px at 50% 50%,transparent 0 17px,rgba(20,255,154,.23) 18px 19px,transparent 20px 29px);background-size:300px 130px;opacity:.35;animation:armazonWaveDriftReverse 17s linear infinite}
@media(prefers-reduced-motion:reduce){body.my-page::before,body.my-page::after{animation:none}}

/* Armazon authentication: black screen with animated teal dotted-wave floor */
body:has(.auth-stage){background:#020609!important;color:#f5f8fb!important;font-family:Georgia,'Times New Roman',serif!important;padding-bottom:0!important;min-height:100vh;overflow-x:hidden}
body:has(.auth-stage) .page{max-width:500px!important;min-height:100vh;padding:0 18px 24px!important;margin:0 auto;background:transparent!important;position:relative;z-index:1}
body:has(.auth-stage) .notice{background:#10232b!important;border:1px solid #0d7895!important;color:#e7faff!important;border-radius:10px!important;margin:12px 0!important}
.auth-stage{position:relative;isolation:isolate;min-height:calc(100vh - 24px);min-height:calc(100dvh - 24px);display:flex;justify-content:center;align-items:flex-start;padding:clamp(52px,12vh,118px) 0 30px;overflow:hidden}
.auth-stage:before,.auth-stage:after{content:"";position:absolute;z-index:-1;left:-35%;width:170%;pointer-events:none}
.auth-stage:before{height:58%;bottom:-4%;opacity:.88;background-image:radial-gradient(circle,#08a9c6 1.35px,transparent 1.8px),radial-gradient(circle,#08778e 1px,transparent 1.6px);background-size:22px 22px,22px 22px;background-position:0 0,11px 11px;transform:perspective(260px) rotateX(56deg) scale(1.18);transform-origin:center bottom;mask-image:linear-gradient(to bottom,transparent 0%,#000 30%,#000 85%,transparent 100%);animation:authWaveDrift 9s linear infinite}
.auth-stage:after{height:42%;bottom:7%;opacity:.36;background:repeating-radial-gradient(ellipse at 50% 100%,transparent 0 17px,rgba(16,168,190,.36) 18px 19px,transparent 20px 34px);transform:perspective(300px) rotateX(62deg);mask-image:linear-gradient(to bottom,transparent,#000 35%,transparent 100%);animation:authWavePulse 5s ease-in-out infinite alternate}
@keyframes authWaveDrift{from{background-position:0 0,11px 11px}to{background-position:0 44px,11px 55px}}
@keyframes authWavePulse{from{opacity:.18;transform:perspective(300px) rotateX(62deg) translateY(5px)}to{opacity:.48;transform:perspective(300px) rotateX(62deg) translateY(-5px)}}
.auth-content{width:100%;max-width:430px;position:relative;z-index:1}
.auth-brand-word{text-align:center;color:#14b9e8;font:700 18px Arial,sans-serif;letter-spacing:3px;margin:0 0 16px;text-shadow:0 0 14px #00aee944}
.auth-welcome{text-align:center;color:#fff;font:700 clamp(31px,8vw,42px) Georgia,serif;margin:0 0 clamp(42px,9vh,76px);letter-spacing:.2px}
.wave-auth-form{display:flex;flex-direction:column;gap:clamp(17px,3.2vh,25px);width:100%}
.wave-field{height:62px;min-width:0;display:flex;align-items:center;gap:13px;padding:0 15px;border:1.4px solid #08708e;border-radius:23px;background:rgba(0,5,9,.72);box-shadow:0 0 0 1px #08708e18,inset 0 0 12px #0b8aa00a}
.wave-field:focus-within{border-color:#12b9e9;box-shadow:0 0 13px #00aee933,inset 0 0 10px #00aee910}
.wave-field>svg{width:23px;height:23px;flex:0 0 23px;fill:none;stroke:#e3eaf0;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
.wave-field input,.wave-field select{width:100%;min-width:0;height:100%;border:0;outline:0;background:transparent;color:#f5f8fb;font:16px Georgia,serif}
.wave-field input::placeholder{color:#8c929b;opacity:1}
.wave-field select{appearance:none;color:#aeb8c1}
.wave-field select option{background:#071018;color:#fff}
.wave-eye{height:40px;width:38px;flex:0 0 38px;display:grid;place-items:center;border:0;background:transparent;color:#e3eaf0;padding:0}
.wave-eye svg{width:23px;height:23px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.wave-eye.revealed{color:#18c4ee}
.wave-submit{height:58px;margin-top:2px;border:1.5px solid #12b9e9;border-radius:22px;background:rgba(0,7,12,.68);color:#16bde9;font:24px Georgia,serif;box-shadow:0 0 10px #00aee91a;cursor:pointer}
.wave-submit:active{background:#06202a}
.wave-auth-switch{display:flex;justify-content:space-between;align-items:center;margin-top:16px;padding:0 5px}
.wave-auth-switch a{color:#f0f3f6;text-decoration:none;font:16px Georgia,serif}
@media(max-width:380px){.auth-stage{padding-top:48px}.auth-welcome{margin-bottom:40px}.wave-field{height:57px;border-radius:20px;padding:0 13px}.wave-auth-form{gap:16px}.wave-submit{height:54px;border-radius:19px}}
@media(max-height:720px){.auth-stage{padding-top:25px}.auth-welcome{margin-bottom:28px}.wave-auth-form{gap:13px}.wave-field{height:54px}.wave-submit{height:51px}.wave-auth-switch{margin-top:8px}}

/* Shared animated teal dotted-wave background across every signed-in platform page */
body:not(:has(.auth-stage)){
  position:relative!important;
  isolation:isolate!important;
  min-height:100vh;
  background:#020609!important;
  color:#f3f7fa!important;
}
body:not(:has(.auth-stage))::before,
body:not(:has(.auth-stage))::after{
  content:"";
  position:fixed;
  inset:0;
  z-index:-1;
  pointer-events:none;
  background-repeat:repeat;
}
body:not(:has(.auth-stage))::before{
  opacity:.82;
  background-image:
    radial-gradient(circle,rgba(15,190,214,.82) 1.25px,transparent 1.9px),
    radial-gradient(circle,rgba(5,117,145,.68) 1px,transparent 1.7px);
  background-size:25px 25px,25px 25px;
  background-position:0 0,12px 12px;
  transform:perspective(500px) rotateX(48deg) scale(1.55);
  transform-origin:center bottom;
  mask-image:linear-gradient(to bottom,transparent 8%,transparent 34%,#000 62%,#000 90%,transparent 100%);
  animation:platformDottedWave 11.5s linear infinite;
}
body:not(:has(.auth-stage))::after{
  opacity:.42;
  background-image:repeating-radial-gradient(ellipse at 50% 100%,transparent 0 18px,rgba(11,166,190,.3) 19px 20px,transparent 21px 37px);
  background-size:100% 230px;
  background-position:center bottom;
  mask-image:linear-gradient(to bottom,transparent 35%,#000 72%,transparent 100%);
  animation:platformWavePulse 6s ease-in-out infinite alternate;
}
@keyframes platformDottedWave{
  from{background-position:0 0,12px 12px}
  to{background-position:0 50px,12px 62px}
}
@keyframes platformWavePulse{
  from{opacity:.2;transform:translateY(7px)}
  to{opacity:.48;transform:translateY(-8px)}
}
/* Keep page surfaces transparent so the same wave field remains visible behind content. */
body:not(:has(.auth-stage)) .page,
body:not(:has(.auth-stage)) main{background:transparent!important}
body:not(:has(.auth-stage)) .topbar{background:rgba(3,8,13,.92)!important}
body:not(:has(.auth-stage)) .bottom-nav{backdrop-filter:blur(12px)}
@media(prefers-reduced-motion:reduce){
  body:not(:has(.auth-stage))::before,
  body:not(:has(.auth-stage))::after{animation:none!important}
}

/* Compact Amazon AI machine catalogue */
.ai-catalog{padding:2px 0 18px;color:#f2f8fb}
.ai-series-tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:5px;margin:0 -12px 10px;padding:5px 10px 0;background:rgba(3,10,15,.86);border-bottom:1px solid rgba(30,190,203,.35)}
.ai-series-tabs a{display:block;text-align:center;text-decoration:none;color:#a9bdc8;padding:12px 3px 10px;font:600 14px Arial,sans-serif;border-bottom:3px solid transparent}
.ai-series-tabs a.selected{color:#42d9ce;border-bottom-color:#42d9ce}
.ai-series-note{margin:10px 0 12px;padding:10px 12px;border:1px solid rgba(29,190,194,.55);border-radius:11px;background:rgba(7,25,30,.84);color:#d8e9ed;font:12px/1.45 Arial,sans-serif}
.ai-machine-list{display:grid;gap:10px}
.ai-machine-card{display:grid;grid-template-columns:35% minmax(0,1fr);min-height:112px;overflow:hidden;border:1px solid #16b9c4;border-radius:12px;background:rgba(7,17,23,.94);box-shadow:0 0 9px rgba(0,197,210,.22)}
.ai-machine-photo{min-width:0;background:#101b20;display:flex;align-items:center;justify-content:center}
.ai-machine-photo img{display:block;width:100%;height:100%;min-height:112px;max-height:145px;object-fit:cover}
.ai-machine-info{min-width:0;padding:9px 10px;display:flex;flex-direction:column;justify-content:center;gap:5px;font-family:Arial,sans-serif}
.ai-machine-title{font-size:16px;font-weight:800;color:#48d8d0;margin-bottom:1px;line-height:1.2}
.ai-machine-detail{display:flex;justify-content:space-between;align-items:baseline;gap:6px;font-size:11.5px;line-height:1.25;color:#b9cbd1}
.ai-machine-detail strong{color:#f4f8fa;font-size:11.5px;text-align:right;white-space:nowrap}
.ai-demo-note{font:10px/1.4 Arial,sans-serif;color:#9db4bb;text-align:center;margin:12px 8px 4px}
@media(max-width:380px){.ai-machine-card{grid-template-columns:33% minmax(0,1fr);min-height:104px}.ai-machine-photo img{min-height:104px;max-height:128px}.ai-machine-info{padding:7px 8px;gap:4px}.ai-machine-title{font-size:14px}.ai-machine-detail,.ai-machine-detail strong{font-size:10.5px}.ai-series-tabs a{font-size:13px}}

/* Machine catalogue: make the total return easy to spot */
.ai-machine-detail.ai-total-income strong { color: #12b981; font-weight: 800; }

/* Five machine-series tabs including K Series */
.ai-series-tabs{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:0}
.ai-series-tabs a{min-width:0;text-align:center;white-space:nowrap;font-size:13px;padding:12px 2px}
@media(max-width:380px){.ai-series-tabs a{font-size:12px}}

/* D-series tab and compact six-series navigation in the Amazon home-page teal theme */
.ai-series-tabs{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:2px;overflow-x:auto;scrollbar-width:none}
.ai-series-tabs::-webkit-scrollbar{display:none}
.ai-series-tabs a{white-space:nowrap;text-align:center;color:#68716f;text-decoration:none;padding:12px 3px 10px;font-size:13px;border-bottom:3px solid transparent}
.ai-series-tabs a.selected{color:#079b8a;border-bottom-color:#079b8a;font-weight:bold}
.ai-machine-card{border-color:#079b8a;box-shadow:0 2px 8px #079b8a22}
.ai-machine-title{color:#087f72}
.ai-total-income strong{color:#087f72}
@media(max-width:380px){.ai-series-tabs a{font-size:12px;padding-left:1px;padding-right:1px}}

/* AI catalogue now follows the actual home dashboard: charcoal, black and gold (not teal/green) */
body:not(.home-page) .topbar{background:#0b1015!important;border:0!important;border-top:4px solid #ffd21c!important;box-shadow:none!important}
body:not(.home-page) .brand-mark{background:transparent!important;color:#ffd21c!important;box-shadow:none!important}
body:not(.home-page) .brand-word{color:#f6f7f8!important;background:none!important;-webkit-text-fill-color:#f6f7f8!important}
body:not(.home-page) .notification{background:transparent!important;color:#ffd21c!important}
body:has(.ai-catalog){background:#0b1015!important;color:#f5f6f7!important;font-family:Arial,Helvetica,sans-serif!important}
body:has(.ai-catalog) .page{background:transparent!important}
.ai-catalog{color:#f5f6f7!important}
.ai-series-tabs{background:#0b1015!important;border-bottom:1px solid #303943!important}
.ai-series-tabs a{color:#aeb5bb!important;border-bottom-color:transparent!important}
.ai-series-tabs a.selected{color:#ffd21c!important;border-bottom-color:#ffd21c!important}
.ai-series-note{border:1px solid #303943!important;background:linear-gradient(145deg,#171f27,#11171d)!important;color:#e7e9eb!important}
.ai-machine-card{border:1px solid #303943!important;background:linear-gradient(145deg,#171f27,#11171d)!important;box-shadow:0 2px 7px #0005!important}
.ai-machine-photo{background:#11171d!important}
.ai-machine-title{color:#ffd21c!important}
.ai-machine-detail{color:#d5d9dc!important}
.ai-machine-detail strong{color:#f8f9fa!important}
.ai-machine-detail.ai-total-income strong{color:#ffd21c!important}
.ai-demo-note{color:#aeb5bb!important}
body:has(.ai-catalog) .bottom-nav{background:rgba(17,23,29,.97)!important;border-color:#303943!important;box-shadow:0 5px 22px #0008!important}
body:has(.ai-catalog) .bottom-nav a{color:#c5cbd0!important}
body:has(.ai-catalog) .bottom-nav a.active{color:#ffd21c!important}

/* Compact machine detail and purchase feedback; matches the homepage teal palette */
.machine-link{display:grid;text-decoration:none;color:inherit}
.ai-machine-card.machine-link{cursor:pointer}
.ai-machine-card.machine-link:active{transform:scale(.99)}
.machine-detail{max-width:560px;margin:0 auto;padding:6px 0 18px;font-family:Georgia,'Times New Roman',serif}
.detail-back{display:inline-block;color:#078f81;text-decoration:none;font-size:13px;margin:3px 0 9px}
.detail-image{width:100%;height:175px;object-fit:contain;background:#f4f8f7;border-radius:13px;display:block}
.detail-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:9px 0 3px}
.detail-heading h2{font-size:19px;margin:0 0 3px}.detail-heading small{font-size:12px;color:#666}
.detail-price{font-size:20px;color:#079b8a;text-align:right}
.detail-description{font-size:13px;line-height:1.35;margin:7px 0 10px}
.detail-panel{background:#fff;border:1.5px solid #079b8a;border-radius:13px;padding:10px 12px;margin:9px 0;box-shadow:0 2px 7px #079b8a20}
.detail-panel div{display:flex;justify-content:space-between;gap:10px;padding:7px 0;font-size:13px}
.detail-panel b{text-align:right;font-weight:700}
.balances{background:#f5fbfa}
.purchase-form{margin:10px 0}
.payment-note{font-size:12px;margin:7px 0}
.payment-choice{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.payment-choice button,.purchase-button{border:0;border-radius:10px;padding:11px 5px;font-size:14px;font-weight:bold;color:#fff;background:#079b8a}
.payment-choice button:first-child{background:#087f72}
.payment-choice button:last-child{background:#079b8a}
.purchase-button{width:100%}
.detail-disclaimer{font-size:10px;color:#777;line-height:1.35;margin-top:10px}
.notice-error{background:#ff0000!important;color:#fff!important;border:1px solid #d00000;font-weight:bold}
.notice-success{background:#00c853!important;color:#fff!important;border:1px solid #009b3f;font-weight:bold}
@media(max-width:380px){.detail-image{height:145px}.detail-price{font-size:18px}.detail-panel div{font-size:12px;padding:6px 0}}

/* Readability fix: force dark text on light information cards */
.machine-detail .detail-panel,
.machine-detail .detail-panel.balances{
  background:#ffffff !important;
  color:#17212b !important;
  opacity:1 !important;
}
.machine-detail .detail-panel div,
.machine-detail .detail-panel span,
.machine-detail .detail-panel b{
  color:#17212b !important;
  opacity:1 !important;
  visibility:visible !important;
  text-shadow:none !important;
}
.machine-detail .detail-panel span{font-weight:500}
.machine-detail .detail-panel b{font-weight:700}
.machine-detail .detail-description,
.machine-detail .detail-heading h2,
.machine-detail .detail-heading small,
.machine-detail .payment-note,
.machine-detail .detail-disclaimer{
  opacity:1 !important;
}
.notice-error{
  background:#ff0000 !important;
  color:#ffffff !important;
  border:2px solid #ff0000 !important;
  font-size:16px !important;
  line-height:1.4 !important;
  font-weight:800 !important;
  padding:13px 14px !important;
  border-radius:10px !important;
  opacity:1 !important;
}
.notice-error *{color:#ffffff !important}
.notice-success{
  background:#00c853 !important;
  color:#ffffff !important;
  border:2px solid #00c853 !important;
  font-size:16px !important;
  line-height:1.4 !important;
  font-weight:800 !important;
  padding:13px 14px !important;
  border-radius:10px !important;
  opacity:1 !important;
}
.notice-success *{color:#ffffff !important}

/* Highest-priority flash status colours */
html body:not(.compact-auth) .page .notice.notice-error{
  background-color:#ff0000 !important;
  background-image:none !important;
  color:#ffffff !important;
  border:2px solid #ff0000 !important;
  box-shadow:none !important;
  font-weight:800 !important;
  opacity:1 !important;
}
html body:not(.compact-auth) .page .notice.notice-error,
html body:not(.compact-auth) .page .notice.notice-error *{
  color:#ffffff !important;
}
html body:not(.compact-auth) .page .notice.notice-success{
  background-color:#00c853 !important;
  background-image:none !important;
  color:#ffffff !important;
  border:2px solid #00c853 !important;
  box-shadow:none !important;
  font-weight:800 !important;
  opacity:1 !important;
}
html body:not(.compact-auth) .page .notice.notice-success,
html body:not(.compact-auth) .page .notice.notice-success *{
  color:#ffffff !important;
}

/* Compact invitation and team page — matched to the dark home palette */
body.team-page{background:#0b1015!important;color:#f4f6f7!important;font-family:Arial,Helvetica,sans-serif!important;padding-bottom:100px!important}
body.team-page .page{max-width:760px!important;padding:10px 14px 22px!important;background:transparent!important}
.team-page .invite-page{display:grid;gap:16px;color:#f4f6f7}
.team-page .invite-hero{background:linear-gradient(145deg,#151f27,#0e151b);border:1px solid #263943;border-radius:18px;padding:17px 15px;box-shadow:0 8px 24px #0005}
.team-page .invite-heading{display:flex;align-items:center;gap:11px;margin-bottom:16px}
.team-page .invite-icon{width:42px;height:42px;border-radius:13px;background:#087f75;display:grid;place-items:center;flex:none}
.team-page svg{width:23px;height:23px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.team-page .invite-heading strong{display:block;font-size:17px}
.team-page .invite-heading small,.team-page .invite-copy-text small{display:block;color:#aebbc2;font-size:10px;margin-top:3px;letter-spacing:.7px}
.team-page .invite-copy-row{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:11px 0;border-top:1px solid #28363e}
.team-page .invite-copy-text{min-width:0;flex:1}
.team-page .invite-copy-text strong{display:block;font-size:17px;letter-spacing:.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:4px;color:#fff}
.team-page .copy-btn{display:flex;align-items:center;justify-content:center;gap:6px;border:1px solid #087f75;background:#087f75;color:#fff;border-radius:10px;padding:9px 12px;font-size:12px;font-weight:700;white-space:nowrap;min-width:88px}
.team-page .copy-btn svg{width:15px;height:15px}
.team-page .invite-hint{font-size:11px;color:#9eabb2;margin:8px 0 0}
.team-page h2{font-size:18px;font-weight:700;margin:0}
.team-page .team-summary{display:grid;gap:10px}
.team-page .team-stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.team-page .team-stat-card{display:flex;align-items:center;gap:9px;background:#141e25;border:1px solid #263943;border-radius:14px;padding:12px 10px;min-width:0}
.team-page .stat-icon{width:38px;height:38px;display:grid;place-items:center;border-radius:11px;background:#087f75;color:#fff;flex:none}
.team-page .stat-icon svg{width:22px;height:22px}
.team-page .team-stat-card strong{display:block;font-size:17px;white-space:nowrap}
.team-page .team-stat-card small{display:block;color:#aebbc2;font-size:10px;margin-top:3px;text-transform:uppercase}
.team-page .team-level-heading{display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-top:2px}
.team-page .team-level-heading span{font-size:11px;color:#9eabb2}
.team-page .team-level-card{overflow:hidden;border:1px solid #263943;border-radius:14px;background:#131c23;box-shadow:0 4px 14px #0003}
.team-page .team-level-card header{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px 12px;background:#123b3b;color:#fff;font-size:13px}
.team-page .team-level-card header>span{display:flex;align-items:center;gap:8px;font-weight:700}
.team-page .team-level-card header strong{font-size:11px;color:#b8eee3}
.team-page .level-dot{font-style:normal;width:23px;height:23px;border-radius:8px;background:#087f75;display:grid;place-items:center;font-size:11px}
.team-page .level-stats{display:flex;justify-content:space-between;padding:12px}
.team-page .level-stats>div{display:grid;gap:3px}
.team-page .level-stats>div:last-child{text-align:right}
.team-page .level-stats strong{font-size:16px}
.team-page .level-stats small{font-size:11px;color:#9eabb2}
@media(max-width:360px){
 .team-page .page{padding-left:10px!important;padding-right:10px!important}
 .team-page .invite-hero{padding:13px 11px}
 .team-page .team-stat-card{padding:9px 7px;gap:7px}
 .team-page .stat-icon{width:33px;height:33px}
 .team-page .team-stat-card strong{font-size:14px}
 .team-page .copy-btn{min-width:76px;padding:8px 9px}
}

/* Final invite-page alignment: exact Amazon home palette and readable mobile sizing */
body.team-page{
 background:#0b1015!important;color:#f5f6f7!important;
 font-family:Arial,Helvetica,sans-serif!important;
 padding-bottom:82px!important;position:relative;isolation:isolate;overflow-x:hidden!important
}
body.team-page::before,body.team-page::after{
 content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;
 background-repeat:repeat;opacity:.48
}
body.team-page::before{
 background-image:
 repeating-radial-gradient(ellipse 210px 65px at 10% 70%,transparent 0 22px,rgba(0,224,139,.27) 23px 24px,transparent 25px 37px),
 repeating-radial-gradient(ellipse 230px 75px at 90% 20%,transparent 0 23px,rgba(29,235,143,.2) 24px 25px,transparent 26px 39px);
 background-size:520px 260px
}
body.team-page::after{
 background-image:repeating-radial-gradient(ellipse 175px 45px at 50% 50%,transparent 0 17px,rgba(20,255,154,.23) 18px 19px,transparent 20px 29px);
 background-size:300px 130px;opacity:.25
}
body.team-page .topbar{display:none!important}
body.team-page .page{width:100%!important;max-width:580px!important;margin:0 auto!important;padding:10px 11px 14px!important;background:transparent!important;overflow:visible!important}
.team-page .invite-page{width:100%;min-width:0;display:grid;gap:13px;color:#f5f6f7}
.team-page .invite-hero{background:linear-gradient(145deg,rgba(23,31,39,.97),rgba(11,16,21,.97));border:1px solid #303943;border-radius:16px;padding:14px 13px;box-shadow:0 5px 18px #0008;min-width:0}
.team-page .invite-icon,.team-page .stat-icon{background:#ffd21c!important;color:#10151a!important}
.team-page .invite-heading{margin-bottom:12px}
.team-page .invite-heading strong{color:#fff;font-size:16px}
.team-page .invite-heading small,.team-page .invite-copy-text small{color:#c5cbd0!important}
.team-page .invite-copy-row{border-top:1px solid #303943;min-width:0}
.team-page .invite-copy-text{min-width:0;overflow:hidden}
.team-page .invite-copy-text strong{color:#fff!important;font-size:clamp(14px,4vw,17px);overflow-wrap:anywhere}
.team-page .copy-btn{background:#ffd21c!important;border:1px solid #ffd21c!important;color:#11171d!important;flex:0 0 auto}
.team-page .invite-hint{color:#c5cbd0!important;line-height:1.45}
.team-page h2{color:#fff!important;font-size:17px}
.team-page .team-stat-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
.team-page .team-stat-card{background:linear-gradient(145deg,#171f27,#11171d)!important;border:1px solid #303943!important;box-shadow:0 4px 14px #0006;padding:10px 8px;min-width:0}
.team-page .team-stat-card strong{color:#fff!important;font-size:clamp(13px,3.7vw,17px)}
.team-page .team-stat-card small{color:#c5cbd0!important;font-size:9px}
.team-page .team-level-heading span{color:#c5cbd0!important}
.team-page .team-level-card{background:rgba(17,23,29,.97)!important;border:1px solid #303943!important;box-shadow:0 4px 14px #0006}
.team-page .team-level-card header{background:#202a33!important;color:#fff!important;border-bottom:1px solid #303943}
.team-page .team-level-card header strong{color:#ffd21c!important}
.team-page .level-dot{background:#ffd21c!important;color:#11171d!important}
.team-page .level-stats strong{color:#fff!important}
.team-page .level-stats small{color:#c5cbd0!important}
body.team-page .bottom-nav{left:7px!important;right:7px!important;bottom:5px!important;height:58px!important;border-radius:18px!important;padding:4px!important;background:linear-gradient(145deg,#171f27,#11171d)!important;border:1px solid #303943!important;box-shadow:0 5px 20px #0009!important}
body.team-page .bottom-nav a{color:#f1f3f5!important;font-family:Arial,sans-serif!important;font-size:11px!important}
body.team-page .bottom-nav a svg{width:22px!important;height:22px!important}
body.team-page .bottom-nav a.active{color:#ffd21c!important}
@media(max-width:370px){
 body.team-page .page{padding-left:8px!important;padding-right:8px!important}
 .team-page .team-stat-card{gap:6px;padding:8px 6px}
 .team-page .stat-icon{width:32px;height:32px}
 .team-page .team-stat-card small{font-size:8px}
 .team-page .invite-hero{padding:12px 10px}
 .team-page .copy-btn{min-width:68px;padding:8px 7px;font-size:11px}
}

/* Income page styling retained */
.income-empty{margin:54px 4px 0;padding:25px 12px;border:1px dashed #6b6656;border-radius:12px;background:#151719;text-align:center;color:#c5c0b4;font-size:17px}
.income-transaction-list{display:grid;gap:9px}
.income-transaction{display:flex;align-items:center;gap:10px;padding:12px;background:#17191a;border:1px solid #393323;border-radius:12px}
.income-transaction-mark{width:35px;height:35px;flex:0 0 35px;border-radius:10px;display:grid;place-items:center;background:#302811;color:#ffd21c}
.income-transaction-mark svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.income-transaction-info{flex:1;min-width:0}
.income-transaction-info strong{display:block;color:#f7f3e8;font-size:13px;text-transform:capitalize}
.income-transaction-info small{display:block;color:#9f9a8d;font-size:10px;margin-top:4px}
.income-amount{color:#ffd21c;font-size:12px;white-space:nowrap}
@media(max-width:360px){body.team-page .page,body.income-page .page{padding-left:10px!important;padding-right:10px!important}.team-member-card{padding:9px;gap:7px}.deposit-status{font-size:9px;padding:5px 6px}.team-member-info strong{font-size:12px}}




/* VIP TASK PAGE FIX — scoped only to this page */
.vip-task-page{font-family:Arial,Helvetica,sans-serif!important;color:#f4f4f4;padding:8px 0 24px;}
body:has(.vip-task-page){background:#080a0d!important;color:#f4f4f4!important;font-family:Arial,Helvetica,sans-serif!important;}
body:has(.vip-task-page) .page{background:transparent;padding:8px 12px 100px!important;max-width:680px;}
body:has(.vip-task-page) .topbar{background:#0c0f13!important;border-top:4px solid #ffd21c!important;border-bottom:1px solid #242424!important;}
body:has(.vip-task-page) .brand-mark{background:#ffd21c!important;color:#111!important;box-shadow:none!important;}
body:has(.vip-task-page) .brand-word{background:none!important;color:#f7f7f7!important;-webkit-text-fill-color:#f7f7f7!important;}
body:has(.vip-task-page) .notification{background:transparent!important;color:#ffd21c!important;}
.vip-task-heading{display:flex;align-items:center;gap:10px;padding:7px 2px 14px;margin:0 0 12px;border-bottom:1px solid #292929;}
.vip-task-heading>a{display:grid;place-items:center;flex:0 0 28px;width:28px;height:32px;color:#ffd21c!important;text-decoration:none;font:32px/1 Arial,sans-serif!important;}
.vip-task-heading>div{min-width:0;display:grid;gap:4px;}
.vip-task-heading h1{margin:0!important;color:#fff!important;font:800 23px/1.2 Arial,Helvetica,sans-serif!important;letter-spacing:-.4px;}
.vip-task-heading p{margin:0!important;color:#b8b8b8!important;font:12px/1.4 Arial,Helvetica,sans-serif!important;}
.vip-crown{margin-left:auto;color:#ffd21c;font-size:25px;}
.vip-task-note{display:grid;grid-template-columns:1fr;gap:5px;margin:0 0 13px;padding:12px 13px;border:1px solid #51451b;border-left:3px solid #ffd21c;border-radius:12px;background:linear-gradient(135deg,#191710,#111214 78%);color:#c9c9c9;font:12px/1.5 Arial,Helvetica,sans-serif!important;}
.vip-task-note strong{color:#ffd21c;font-size:13px;line-height:1.3;}
.vip-task-list{display:grid;grid-template-columns:minmax(0,1fr);gap:10px;}
.vip-task-card{display:block;min-width:0;padding:12px;border:1px solid #393326;border-radius:13px;background:linear-gradient(145deg,#1a1a18,#101114 78%);box-shadow:0 3px 12px #0008;color:#f3f3f3;font-family:Arial,Helvetica,sans-serif;}
.vip-card-top{display:flex;align-items:center;gap:10px;min-width:0;}
.vip-level-icon{display:grid;place-items:center;flex:0 0 34px;width:34px;height:34px;border-radius:10px;background:#302710;color:#ffd21c;font-size:19px;}
.vip-card-top>div{display:grid;gap:4px;min-width:0;}
.vip-card-top>div strong{display:block;color:#fff;font:800 15px/1.2 Arial,sans-serif;white-space:nowrap;}
.vip-card-top>div small{display:block;color:#bdbdbd;font:11px/1.3 Arial,sans-serif;white-space:normal;}
.vip-reward{display:block;margin-left:auto;flex:0 0 auto;color:#ffd21c;font:800 12px/1.2 Arial,sans-serif;white-space:nowrap;}
.vip-progress-line{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:12px 0 6px;color:#bdbdbd;font:11px/1.2 Arial,sans-serif;}
.vip-progress-line b{color:#fff;font:700 11px/1.2 Arial,sans-serif;font-variant-numeric:tabular-nums;white-space:nowrap;}
.vip-progress-track{height:7px;width:100%;overflow:hidden;border-radius:20px;background:#353535;}
.vip-progress-track i{display:block;height:100%;max-width:100%;border-radius:20px;background:linear-gradient(90deg,#b88b08,#ffd21c);}
.vip-card-bottom{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:7px;margin-top:10px;color:#c4c4c4;font:11px/1.3 Arial,sans-serif;}
.vip-card-bottom>span:first-child b{color:#ffd21c;margin-left:3px;font-weight:800;}
.vip-status{color:#8ee0a5;font:800 9px/1.2 Arial,sans-serif;letter-spacing:.45px;white-space:nowrap;}
.vip-status>span{display:inline-grid;place-items:center;width:15px;height:15px;margin-right:3px;border-radius:50%;background:#236b37;color:#fff;}
.vip-status.pending{color:#d7b85b;}
.vip-task-card.is-complete{border-color:#477b43;background:linear-gradient(145deg,#172319,#101411 78%);}
body:has(.vip-task-page) .bottom-nav{background:#101216!important;border-color:#4b3c13!important;}
body:has(.vip-task-page) .bottom-nav a{color:#b7bbc1!important;}
body:has(.vip-task-page) .bottom-nav a.active{color:#ffd21c!important;}
body:has(.vip-task-page) .floating-support{z-index:19;}
@media(max-width:380px){.vip-task-heading h1{font-size:21px!important}.vip-task-card{padding:10px}.vip-card-top{gap:8px}.vip-level-icon{flex-basis:31px;width:31px;height:31px}.vip-reward{font-size:11px}.vip-card-top>div strong{font-size:14px}}

/* Compact Income / purchased machines screen */
body.income-page{background:#fff!important;color:#17191d!important;font-family:Arial,Helvetica,sans-serif!important;}
body.income-page .topbar{display:none!important;}
body.income-page .page{max-width:680px!important;margin:0 auto!important;padding:0 0 88px!important;background:#fff!important;min-height:calc(100vh - 70px);}
.income-screen{min-height:calc(100vh - 70px);background:#fff;color:#17191d;}
.income-screen-header{height:58px;display:grid;grid-template-columns:42px 1fr 42px;align-items:center;padding:0 12px;background:#101116;border-bottom:1px solid #333;}
.income-screen-header>a{color:#fff;text-decoration:none;font:36px/1 Arial,sans-serif;display:flex;align-items:center;height:100%;}
.income-screen-header h1{margin:0;text-align:center;color:#fff;font:bold 21px Georgia,serif;}
.income-content{padding:16px 12px 28px;}
.income-section-title{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:3px 2px 12px;}
.income-section-title strong{font-size:14px;color:#191b20;}
.income-section-title span{font-size:11px;color:#7c7c7c;white-space:nowrap;}
.purchased-machine-list{display:grid;gap:9px;}
.purchased-machine-card{display:flex;align-items:center;gap:10px;padding:9px;border:1px solid #e4e4e4;border-radius:10px;background:#fff;box-shadow:0 2px 7px #0000000a;min-width:0;}
.purchased-machine-card>img,.purchased-machine-placeholder{width:76px;height:76px;flex:0 0 76px;object-fit:cover;border-radius:7px;background:#17191d;}
.purchased-machine-placeholder{display:grid;place-items:center;color:#ffd21c;font-size:28px;font-weight:800;}
.purchased-machine-details{flex:1;min-width:0;}
.purchased-machine-name{font-size:13px;font-weight:800;color:#17191d;}
.purchased-machine-meta{font-size:9px;color:#858585;margin-top:3px;overflow-wrap:anywhere;}
.purchased-machine-values{display:flex;gap:16px;margin-top:8px;flex-wrap:wrap;}
.purchased-machine-values span{display:grid;gap:2px;}
.purchased-machine-values small{font-size:9px;color:#858585;}
.purchased-machine-values b{font-size:11px;color:#a77b00;}
.purchased-machine-duration{font-size:9px;color:#777;margin-top:5px;}
.income-no-machines{margin:22px 2px 0;padding:17px 10px;border:1px dashed #c9c9c9;border-radius:10px;background:#f8f9fa;text-align:center;color:#858585;font:16px Georgia,serif;}
body.income-page .bottom-nav{left:7px!important;right:7px!important;bottom:5px!important;height:58px!important;border-radius:16px!important;padding:4px!important;background:#111318!important;border:1px solid #333!important;box-shadow:0 4px 16px #0003!important;}
body.income-page .bottom-nav a{color:#f1f1f1!important;font-family:Arial,sans-serif!important;font-size:10px!important;}
body.income-page .bottom-nav a svg{width:21px!important;height:21px!important;}
body.income-page .bottom-nav a.active{color:#ffd21c!important;}
@media(max-width:360px){.income-content{padding-left:9px;padding-right:9px}.purchased-machine-card{gap:8px;padding:8px}.purchased-machine-card>img,.purchased-machine-placeholder{width:65px;height:65px;flex-basis:65px}.purchased-machine-values{gap:10px}.purchased-machine-values b{font-size:10px}}
/* Compact finance, bills and admin screens — inherit Armazon charcoal/gold palette */
.panel{background:#171717;color:#f5f5f5;border:1px solid rgba(255,210,28,.25);border-radius:14px;padding:14px;margin:10px 0 80px;box-shadow:0 8px 24px #0002}.panel h2{font-size:20px;margin:3px 0 14px;color:#ffd21c}.panel h3{font-size:15px;color:#ffd21c;margin:20px 0 8px}.panel label{display:block;font-size:13px;margin:12px 0 6px}.panel input:not([type=radio]):not([type=checkbox]),.panel textarea{width:100%;box-sizing:border-box;border:1px solid #555;background:#242424;color:#fff;border-radius:9px;padding:11px;margin:4px 0}.panel textarea{min-height:85px}.primary,.panel button{display:inline-block;background:#ffd21c;color:#171717;border:0;border-radius:9px;padding:11px 15px;font-weight:800;text-decoration:none;margin-top:10px}.balance-card,.recipient{background:#242424;border:1px solid #ffd21c55;border-radius:12px;padding:13px;margin:10px 0}.balance-card h1{font-size:24px;color:#ffd21c;margin:5px 0}.muted,.panel small{color:#aaa;font-size:12px}.pay-options{display:grid;gap:8px}.pay-options label{background:#242424;padding:10px;border-radius:9px}.transaction,.admin-row{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:10px 0;border-bottom:1px solid #444;font-size:13px;flex-wrap:wrap}.transaction>div{display:grid;gap:4px}.status{color:#ffd21c}.admin-row form{display:flex;gap:5px;flex-wrap:wrap}.admin-row button{padding:7px 9px;font-size:11px}.chat-msg{background:#282828;border-radius:10px;padding:10px;margin:8px 0}.chat-msg small{display:block;margin-top:5px}@media(max-width:420px){.panel{padding:11px;margin:6px 0 76px}.admin-row{font-size:11px}.admin-row input{max-width:110px}}
.service-links{display:grid;grid-template-columns:1fr 1fr;gap:8px}.service-links a{padding:11px;border-radius:9px;background:#242424;color:#ffd21c;text-decoration:none;border:1px solid #ffd21c44;font-size:13px}

/* PREMIUM ARMAZON DARK UI — no white surfaces on finance/admin screens */
:root{--az-bg:#050b14;--az-panel:#0c1725;--az-panel2:#101f30;--az-line:#1b3850;--az-cyan:#21b9f3;--az-cyan2:#087fbd;--az-gold:#ffd21c;--az-text:#eef6ff;--az-muted:#91a6ba;--az-red:#ff5364;}
html,body{background:var(--az-bg)!important;color:var(--az-text)!important}
body:not(:has(.compact-auth)) .page{background:transparent!important}
body:not(:has(.compact-auth)) .topbar{background:#07111e!important;border-bottom:1px solid #17324a!important}
body:not(:has(.compact-auth)) .bottom-nav{background:rgba(5,13,23,.97)!important;border:1px solid #21445e!important;box-shadow:0 8px 30px #0009!important}
body:not(:has(.compact-auth)) .bottom-nav a{color:#9bb0c4!important}
body:not(:has(.compact-auth)) .bottom-nav a.active{color:var(--az-cyan)!important}
.finance-shell,.admin-shell{max-width:560px;margin:12px auto 88px;padding:15px;border:1px solid #18334b;border-radius:20px;background:linear-gradient(155deg,#0d1a29 0%,#08111d 60%,#07101a 100%);box-shadow:0 14px 40px #0008;position:relative;overflow:hidden}
.finance-shell:before,.admin-shell:before{content:"";position:absolute;inset:0 0 auto;height:2px;background:linear-gradient(90deg,transparent,var(--az-cyan),var(--az-gold),transparent);opacity:.9}
.finance-heading{display:flex;align-items:center;gap:12px;padding:5px 0 17px;border-bottom:1px solid #1c344a;margin-bottom:16px}
.finance-heading>a{width:38px;height:38px;flex:0 0 38px;display:grid;place-items:center;border:1px solid #24506c;border-radius:12px;color:var(--az-cyan);font:32px/1 Arial;text-decoration:none;background:#0b2031}
.finance-heading>div{min-width:0;flex:1}.eyebrow{display:block;color:var(--az-cyan);font:800 9px/1.4 Arial,sans-serif;letter-spacing:1.7px}
.finance-heading h1,.admin-hero h1{margin:3px 0;color:#f5f9ff;font:800 23px/1.15 Arial,sans-serif;letter-spacing:-.5px}
.finance-heading p,.admin-hero p{margin:4px 0 0;color:var(--az-muted);font:12px/1.4 Arial,sans-serif}
.heading-icon{width:39px;height:39px;display:grid;place-items:center;border-radius:13px;background:#0c2b40;color:var(--az-cyan);font:24px Arial;border:1px solid #1b5776}
.available-card{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:16px;border:1px solid #236184;border-radius:16px;background:linear-gradient(115deg,#0d2b42,#0b1b2b 75%);box-shadow:inset 0 1px #ffffff0a,0 6px 20px #0003;margin:14px 0 20px}
.available-card div{display:grid;gap:5px}.available-card span{font:800 10px Arial;letter-spacing:1px;color:#83ccef}.available-card small{font:11px Arial;color:#91a6ba}.available-card strong{font:800 21px Arial;color:var(--az-gold);white-space:nowrap}
.finance-form{display:grid;gap:9px}.finance-form>label,.machine-admin-card label{font:700 12px Arial;color:#c8d9e8;margin-top:7px}
.amount-field{display:flex;align-items:center;gap:10px;min-height:52px;padding:0 13px;border:1px solid #29465d;border-radius:13px;background:#07121f;box-shadow:inset 0 2px 7px #0005}
.amount-field>span{font:800 11px Arial;color:var(--az-cyan);letter-spacing:.6px;border-right:1px solid #29465d;padding-right:10px}
.amount-field input,.finance-form>input{width:100%;min-width:0;height:48px;border:1px solid #29465d;border-radius:13px;background:#07121f;color:#f5f9ff;padding:0 13px;font:14px Arial;outline:none}
.amount-field input{height:48px;border:0;background:transparent;padding:0}.amount-field:focus-within,.finance-form>input:focus{border-color:var(--az-cyan);box-shadow:0 0 0 3px #21b9f322}
.finance-form input::placeholder,.machine-admin-card input::placeholder{color:#627b91}
.finance-hint{margin:10px 0;padding:13px;border:1px solid #24445d;border-left:3px solid var(--az-cyan);border-radius:13px;background:linear-gradient(120deg,#0c2031,#0a1725);color:#a9bfd1}
.finance-hint b{font:800 12px Arial;color:var(--az-cyan)}.finance-hint p{margin:6px 0 0;font:11px/1.55 Arial;color:#9bb0c2}
.finance-submit{width:100%;min-height:49px;display:flex;align-items:center;justify-content:center;gap:12px;border:1px solid #39c8fa;border-radius:13px;background:linear-gradient(100deg,#087db7,#10a9df);color:#fff;font:800 14px Arial;box-shadow:0 5px 18px #049fe344,inset 0 1px #ffffff33;cursor:pointer;margin-top:8px}
.finance-submit span{font-size:19px}.finance-submit:active{transform:translateY(1px)}
.method-grid{display:grid;gap:8px}.method-option{display:flex;align-items:center;gap:11px;position:relative;padding:11px 12px;border:1px solid #263f55;border-radius:13px;background:linear-gradient(110deg,#101f2e,#0a1522);cursor:pointer;min-height:61px}
.method-option input{position:absolute;opacity:0}.method-symbol{width:34px;height:34px;display:grid;place-items:center;border-radius:11px;background:#ffbf00;color:#161616;font:900 15px Arial}.method-symbol.airtel{background:#e53c49;color:#fff}.method-symbol.usdt{background:#1d9b75;color:#fff}
.method-option>span:nth-of-type(2){display:grid;gap:4px}.method-option b{font:700 12px Arial;color:#edf6ff}.method-option small{font:10px Arial;color:#8299ae}.method-option i{margin-left:auto;width:17px;height:17px;border:1.5px solid #607b91;border-radius:50%;position:relative}
.method-option:has(input:checked){border-color:var(--az-cyan);background:linear-gradient(110deg,#10334a,#0d2031);box-shadow:0 0 0 1px #21b9f344}.method-option:has(input:checked) i{border-color:var(--az-cyan)}.method-option:has(input:checked) i:after{content:"";position:absolute;inset:4px;border-radius:50%;background:var(--az-cyan)}
.panel{background:linear-gradient(150deg,#0d1a29,#08111d)!important;color:#edf5ff!important;border:1px solid #21445e!important;border-radius:18px!important;box-shadow:0 12px 35px #0007!important}
.panel h2,.panel h3{color:var(--az-cyan)!important}.panel input:not([type=radio]):not([type=checkbox]),.panel textarea{background:#07121f!important;border:1px solid #29465d!important;color:#f2f7fc!important;border-radius:11px!important}.panel input::placeholder{color:#657f95!important}.primary,.panel button{background:linear-gradient(100deg,#087db7,#10a9df)!important;color:#fff!important;border:1px solid #39c8fa!important;border-radius:11px!important;box-shadow:0 4px 14px #049fe333!important}
.recipient,.balance-card,.pay-options label{background:#0c2031!important;border:1px solid #24506c!important;color:#f3f8ff!important}.muted,.panel small{color:#91a6ba!important}.notice{background:#10263a!important;color:#e8f5ff!important;border:1px solid #28516c!important}.notice-error{border-color:#a83b4b!important;color:#ffb6bd!important}.notice-success{border-color:#238c68!important;color:#a8f1d2!important}
.admin-shell{padding:14px}.admin-hero{display:flex;align-items:center;justify-content:space-between;padding:7px 2px 17px;border-bottom:1px solid #1c344a}.admin-shield{width:48px;height:48px;display:grid;place-items:center;border-radius:15px;background:#0c2b40;border:1px solid #1d5877;color:var(--az-cyan);font-size:24px}
.admin-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;margin:13px 0}.admin-stats>div{min-width:0;padding:11px 8px;border:1px solid #21445e;border-radius:13px;background:#0b1b2b}.admin-stats small{display:block;color:#8ea8bd;font:800 8px/1.4 Arial;letter-spacing:.5px}.admin-stats b{display:block;color:var(--az-gold);font:800 20px Arial;margin-top:6px}
.admin-section{margin:13px 0;padding:12px;border:1px solid #1c3b54;border-radius:15px;background:linear-gradient(145deg,#0c1a29,#091421)}.admin-section>header{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:9px}.admin-section h2{margin:3px 0;color:#eff7ff;font:800 16px Arial}.section-count{min-width:27px;padding:5px 8px;text-align:center;border-radius:20px;background:#10314a;color:var(--az-cyan);font:800 11px Arial}
.admin-record,.admin-user{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center;padding:11px 0;border-top:1px solid #1c344a}.record-main{min-width:0;display:grid;gap:5px}.record-main>b{color:#f2f7fc;font:800 13px Arial}.record-main>small{color:#8fa6ba;font:10px/1.4 Arial;overflow-wrap:anywhere}.record-status{padding:5px 8px;border-radius:20px;background:#172638;color:#a8bfd1;font:800 9px Arial;text-transform:uppercase}.record-status.pending{background:#382e14;color:#ffd36b}.record-status.approved{background:#103629;color:#81e1b3}.record-status.rejected{background:#3a1c26;color:#ff9eaa}.record-actions,.user-tools{grid-column:1/-1;display:flex;gap:7px;flex-wrap:wrap}.record-actions button,.user-tools button{border:1px solid transparent;border-radius:9px;padding:8px 11px;font:800 10px Arial}.approve-btn{background:#0e755f;color:#d9fff2;border-color:#1caa89!important}.reject-btn{background:#49202b;color:#ffc2ca;border-color:#9b4051!important}.admin-empty{padding:12px;text-align:center;color:#7891a7;font:11px Arial}.user-tools form{display:flex;gap:5px;align-items:center;flex-wrap:wrap}.user-tools input{width:130px;max-width:40vw;background:#07121f;color:#fff;border:1px solid #29465d;border-radius:8px;padding:8px;font:10px Arial}
.machine-admin-card{padding:12px;margin:9px 0;border:1px solid #24445d;border-radius:13px;background:#0a1725}.machine-admin-title{display:flex;align-items:center;justify-content:space-between;margin-bottom:9px}.machine-admin-title>b{color:var(--az-gold);font:800 14px Arial}.sold-toggle{display:flex;align-items:center;gap:5px;color:#ff6978!important;font:800 10px Arial!important}.sold-toggle input{accent-color:#ff5364}.machine-admin-card label{display:grid;gap:5px}.machine-admin-card input:not([type=checkbox]){width:100%;min-width:0;height:36px;padding:0 9px;border:1px solid #29465d;border-radius:8px;background:#07121f;color:#f2f7fc;font:11px Arial}.machine-admin-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.machine-admin-card .finance-submit{min-height:39px;font-size:11px}
body.income-page,body.income-page .income-screen,body.income-page .page{background:var(--az-bg)!important;color:var(--az-text)!important}.income-screen-header{background:#07111e!important;border-bottom:1px solid #21445e!important}.income-content{background:transparent!important}.income-section-title strong{color:#eff7ff!important}.income-section-title span{color:#8ea6bb!important}.purchased-machine-card{background:linear-gradient(130deg,#101f2e,#091522)!important;border:1px solid #24445d!important;box-shadow:0 6px 16px #0005!important}.purchased-machine-name{color:#f3f8ff!important}.purchased-machine-meta,.purchased-machine-values small,.purchased-machine-duration{color:#8ea6bb!important}.purchased-machine-values b{color:var(--az-gold)!important}.income-no-machines{background:#0c1a29!important;border-color:#31506a!important;color:#91a6ba!important}.income-section-title strong{color:#eff7ff!important}
@media(max-width:390px){.finance-shell,.admin-shell{margin:7px 0 82px;padding:11px;border-radius:16px}.finance-heading h1,.admin-hero h1{font-size:20px}.available-card{padding:12px}.available-card strong{font-size:18px}.admin-section{padding:9px}.admin-stats{gap:5px}.admin-stats>div{padding:9px 6px}.admin-stats small{font-size:7px}.admin-stats b{font-size:17px}}

/* BILL PAGE — compact dark Armazon styling, matching the Home visual system */
body.bill-page{background:#050b14!important;color:#eef6ff!important;}
body.bill-page .topbar{display:none!important;}
body.bill-page .page{max-width:680px!important;padding:0 0 88px!important;margin:0 auto!important;min-height:calc(100vh - 68px);background:transparent!important;position:relative;overflow:hidden;}
.bill-screen{min-height:calc(100vh - 68px);position:relative;isolation:isolate;background:linear-gradient(180deg,#050b14 0%,#071321 65%,#050b14 100%);overflow:hidden;}
.bill-screen-header{height:58px;display:grid;grid-template-columns:44px 1fr 44px;align-items:center;padding:0 13px;background:#07111e;border-bottom:1px solid #1d3a52;box-shadow:0 4px 18px #0005;position:relative;z-index:2;}
.bill-screen-header>a{height:38px;width:38px;display:flex;align-items:center;justify-content:flex-start;color:#35bff5;text-decoration:none;font:40px/1 Arial,sans-serif;}
.bill-screen-header h1{margin:0;text-align:center;color:#f2f7fc;font:800 21px Georgia,serif;letter-spacing:.2px;}
.bill-content{position:relative;z-index:2;padding:22px 13px 30px;min-height:240px;}
.bill-summary{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:0 2px 12px;color:#8fa9bf;font:800 9px Arial,sans-serif;letter-spacing:1.1px;}
.bill-summary b{color:#ffd21c;font-size:10px;letter-spacing:0;}
.bill-empty{min-height:91px;margin:72px 4px 0;padding:17px 12px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;border:1px dashed #42627c;border-radius:13px;background:linear-gradient(110deg,#0c1a29dd,#0a1724dd);box-shadow:inset 0 1px #ffffff08,0 8px 24px #0004;text-align:center;}
.bill-empty-icon{width:29px;height:29px;display:grid;place-items:center;border:1px solid #28516c;border-radius:9px;color:#27b9ef;background:#0c263a;font:19px Arial;}
.bill-empty strong{color:#dceaf5;font:16px Georgia,serif;}
.bill-empty small{color:#829bb0;font:10px/1.4 Arial,sans-serif;}
.bill-list{display:grid;gap:8px;}
.bill-transaction{display:grid;grid-template-columns:37px minmax(0,1fr) auto;align-items:center;gap:9px;padding:11px 10px;border:1px solid #1d3b54;border-radius:13px;background:linear-gradient(125deg,#0e1d2c,#091522);box-shadow:0 5px 16px #0004;min-width:0;}
.bill-transaction-icon{width:34px;height:34px;display:grid;place-items:center;border-radius:11px;background:#102d42;border:1px solid #24516e;color:#2bc0f5;font:22px Arial;}
.bill-transaction-main,.bill-transaction-side{display:grid;gap:5px;min-width:0;}
.bill-transaction-main strong{color:#edf6ff;font:700 12px Arial,sans-serif;}
.bill-transaction-main small{color:#8299ad;font:9px/1.35 Arial,sans-serif;overflow-wrap:anywhere;}
.bill-transaction-side{text-align:right;}
.bill-transaction-side>b{color:#ffd21c;font:800 11px Arial,sans-serif;white-space:nowrap;}
.bill-status{justify-self:end;padding:4px 7px;border-radius:20px;background:#17283a;color:#a9c0d2;font:800 8px Arial,sans-serif;letter-spacing:.4px;}
.bill-status.approved,.bill-status.completed{background:#103629;color:#8de5b9;}
.bill-status.pending{background:#382e14;color:#ffd36b;}
.bill-status.rejected,.bill-status.failed{background:#3a1c26;color:#ff9eaa;}
.bill-wave{position:absolute;z-index:1;left:-18%;right:-18%;bottom:8%;height:34%;opacity:.36;pointer-events:none;background-image:radial-gradient(circle,#43bff2 1.05px,transparent 1.5px);background-size:17px 17px;mask-image:radial-gradient(ellipse at 50% 42%,#000 0%,#000 30%,transparent 73%);transform:perspective(240px) rotateX(48deg) scale(1.2);}
body.bill-page .bottom-nav{left:7px!important;right:7px!important;bottom:5px!important;height:58px!important;border-radius:16px!important;padding:4px!important;background:rgba(5,13,23,.97)!important;border:1px solid #21445e!important;box-shadow:0 8px 30px #0009!important;}
body.bill-page .bottom-nav a{color:#9bb0c4!important;font:10px Arial,sans-serif!important;}
body.bill-page .bottom-nav a.active{color:#21b9f3!important;}
@media(max-width:360px){.bill-content{padding-left:9px;padding-right:9px}.bill-empty{margin-top:54px}.bill-transaction{grid-template-columns:32px minmax(0,1fr) auto;gap:7px;padding:9px 8px}.bill-transaction-icon{width:30px;height:30px}.bill-transaction-main strong{font-size:11px}.bill-transaction-side>b{font-size:10px}}
