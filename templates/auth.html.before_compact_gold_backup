{% extends "base.html" %}
{% block content %}
<style>
.auth-stage{box-sizing:border-box;position:relative;isolation:isolate;overflow:hidden;width:100%;min-height:calc(100svh - 24px);display:flex;align-items:center;justify-content:center;padding:24px 16px 30px;color:#f7f6ef;background:radial-gradient(ellipse at 78% 48%,rgba(202,157,68,.24),transparent 34%),radial-gradient(ellipse at 12% 18%,rgba(25,115,91,.28),transparent 38%),linear-gradient(155deg,#071c1a 0%,#102b27 42%,#061512 100%)}
.auth-stage:before{content:"";position:absolute;inset:0;z-index:-1;opacity:.7;background:linear-gradient(90deg,transparent 8%,rgba(4,12,11,.65) 9% 11%,transparent 12% 22%,rgba(4,12,11,.55) 23% 25%,transparent 26% 40%,rgba(4,12,11,.6) 41% 43%,transparent 44% 62%,rgba(4,12,11,.6) 63% 65%,transparent 66% 80%,rgba(4,12,11,.6) 81% 83%,transparent 84%),repeating-linear-gradient(0deg,transparent 0 42px,rgba(222,190,112,.1) 43px 45px,transparent 46px 65px)}
.auth-stage:after{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background:linear-gradient(180deg,rgba(2,13,12,.24),rgba(2,13,12,.16) 48%,rgba(1,12,10,.78))}
.auth-content{box-sizing:border-box;width:100%;max-width:430px;margin:auto}
.auth-brand{display:flex;flex-direction:column;align-items:center;text-align:center;margin:4px 0 25px}
.auth-logo{width:90px;height:90px;border-radius:50%;display:grid;place-items:center;background:#fff;border:7px solid #dfc58a;box-shadow:0 5px 28px #0005;margin-bottom:15px}
.auth-logo span{font-family:Georgia,serif;font-size:60px;line-height:1;font-weight:900;color:#087b59;text-shadow:2px 2px 0 #d4b46e}
.auth-brand-name{font-family:Georgia,serif;font-size:37px;letter-spacing:5px;font-weight:700;line-height:1.1;color:#fff}
.auth-brand-sub{font-size:14px;letter-spacing:7px;color:#d9bd78;font-weight:700;margin-top:8px}
.auth-mode-title{text-align:center;font-size:16px;letter-spacing:7px;font-weight:700;color:#e7dfc9;margin:22px 0 23px}
.wave-auth-form{box-sizing:border-box;width:100%;display:flex;flex-direction:column;gap:12px}
.wave-field{box-sizing:border-box;width:100%;height:66px;min-height:66px;display:flex;align-items:center;padding:0 18px;border-radius:40px;background:rgba(255,255,255,.12);border:1px solid rgba(231,226,202,.48);box-shadow:inset 0 1px 5px #fff1}
.wave-field .auth-symbol{width:32px;flex:0 0 32px;color:#d8bd79;font-size:22px;text-align:left}
.wave-field input{box-sizing:border-box;width:100%;min-width:0;height:62px;border:0;outline:0;background:transparent;color:#fff;font-size:16px;padding:0 8px}
.wave-field input::placeholder{color:rgba(245,246,238,.72);opacity:1}
.wave-submit{width:100%;height:64px;min-height:64px;border:0;border-radius:40px;background:#07845f;color:#fff;font-weight:800;font-size:17px;box-shadow:0 8px 20px rgba(0,0,0,.18);margin-top:6px}
.wave-auth-switch{text-align:center;font-size:15px;line-height:1.5;padding-top:26px;color:rgba(255,255,255,.86)}
.wave-auth-switch a{color:#e2c47b;text-decoration:underline;text-underline-offset:4px;font-weight:800}
.auth-footer{text-align:center;color:#c9cbbd;font-size:11px;margin-top:24px;opacity:.8}
@media(max-width:390px){.auth-stage{padding:18px 13px 24px}.auth-brand{margin-bottom:18px}.auth-logo{width:78px;height:78px;margin-bottom:12px}.auth-logo span{font-size:52px}.auth-brand-name{font-size:32px;letter-spacing:4px}.auth-mode-title{margin:18px 0 19px}.wave-field{height:60px;min-height:60px;padding:0 15px}.wave-field input{height:56px;font-size:15px}.wave-submit{height:60px;min-height:60px}}
</style>
<section class="auth-stage"><div class="auth-content">
  <div class="auth-brand"><div class="auth-logo"><span>P</span></div><div class="auth-brand-name">PIMCO</div><div class="auth-brand-sub">INVESTMENT</div></div>
  {% if mode == 'signup' %}
    <h1 class="auth-mode-title">SIGN UP</h1>
    <form method="post" class="wave-auth-form" autocomplete="on">
      <input type="hidden" name="mode" value="signup">
      <label class="wave-field"><span class="auth-symbol">♙</span><input name="phone" type="tel" placeholder="Phone number" required autocomplete="tel"></label>
      <label class="wave-field"><span class="auth-symbol">♙</span><input id="signup-password" name="password" type="password" placeholder="Create password" minlength="8" required autocomplete="new-password"></label>
      <label class="wave-field"><span class="auth-symbol">♙</span><input id="confirm-password" name="confirm_password" type="password" placeholder="Confirm password" minlength="8" required autocomplete="new-password"></label>
      <label class="wave-field"><span class="auth-symbol">♧</span><input name="invite_code" value="{{ invite_code|default('') }}" placeholder="Invitation code (optional)"></label>
      <button class="wave-submit" type="submit">＋ &nbsp; Sign up</button>
      <div class="wave-auth-switch">Already have an account? <a href="{{ url_for('auth', mode='signin') }}">Sign in</a></div>
    </form>
  {% else %}
    <h1 class="auth-mode-title">SIGN IN</h1>
    <form method="post" class="wave-auth-form" autocomplete="on">
      <input type="hidden" name="mode" value="signin">
      <label class="wave-field"><span class="auth-symbol">♙</span><input name="identity" type="tel" placeholder="Phone number" required autocomplete="username"></label>
      <label class="wave-field"><span class="auth-symbol">♙</span><input name="password" type="password" placeholder="Password" required autocomplete="current-password"></label>
      <button class="wave-submit" type="submit">↪ &nbsp; Sign in</button>
      <div class="wave-auth-switch">Don't have an account yet? <a href="{{ url_for('auth', mode='signup') }}">Sign up</a></div>
    </form>
  {% endif %}
  <div class="auth-footer">PIMCO INVESTMENT</div>
</div></section>
<script>
const signupForm=document.querySelector('form input[name="mode"][value="signup"]')?.form;
if(signupForm)signupForm.addEventListener('submit',e=>{const a=document.getElementById('signup-password'),b=document.getElementById('confirm-password');if(a.value!==b.value){e.preventDefault();b.setCustomValidity('Passwords do not match.');b.reportValidity();}else b.setCustomValidity('');});
</script>
{% endblock %}
